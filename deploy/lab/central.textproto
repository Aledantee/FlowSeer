# flowseer.store.device.v1.DeviceServiceConfig for the lab run.
#
# Nothing here is a secret. The addresses are loopback for the lab run, and
# the authorization ids are stand-ins for the block write-openfga-store.py
# prints once the store exists.

state_dir: "/var/lib/flowseer/device"
registry_path: "/etc/flowseer/registry.textproto"
credential_root: "/etc/flowseer/credentials"

listeners {
  # Loopback for the lab run, and that is a step in the runbook rather than a
  # default worth copying: that port is the one that yields device credentials.
  api: "127.0.0.1:8443"
  bus: "127.0.0.1:8444"
}

edges {
  central_url: "https://127.0.0.1:8443"
  assertion_audience: "flowseer-lab"
  cluster_urls: "wss://127.0.0.1:8444"
}

intervals {
  # Left at their defaults for the lab run except this one. The drift poll
  # would otherwise read the managed interface every five minutes and put a
  # second reader in the middle of a run whose whole point is watching one
  # write.
  drift { seconds: 3600 }
}

authentication {
  issuers {
    issuer: "https://127.0.0.1:8445/dex"
    audience: "flowseer-device"
    organization_claim_name: "groups"
  }
}

platform_admin {
  issuer: "https://127.0.0.1:8445/dex"
  organization: "flowseer-platform"
  organization_claim_name: "groups"
  subjects: "CiQwMDAwMDAwMC0wMDAwLTAwMDAtMDAwMC0wMDAwMDAwMDAwMDISBWxvY2Fs"
}

authorization {
  endpoint: "https://127.0.0.1:8081"
  store_id: "PLACEHOLDER_STORE_ID"
  model_id: "PLACEHOLDER_MODEL_ID"
  preshared_key_file: "/etc/flowseer/secrets/openfga.key"
}
