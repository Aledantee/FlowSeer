# flowseer.store.device.v1.DeviceServiceConfig for the lab run.
#
# Nothing here is a secret. The addresses are loopback for the lab run, and
# the authorization ids are stand-ins for the block write-openfga-store.py
# prints once the store exists.

state_dir: "/var/lib/flowseer/device"
registry_path: "/etc/flowseer/registry.textproto"
credential_root: "/etc/flowseer/credentials"

listeners {
  # Loopback for the lab run, and that is a step in the runbook rather than a
  # default worth copying: that port is the one that yields device credentials.
  api: "127.0.0.1:8443"
  # What an edge calls. central_url below names this address, and the
  # operator calls on api never reach it.
  edge: "127.0.0.1:8446"
}

edges {
  central_url: "https://127.0.0.1:8446"
  assertion_audience: "flowseer-lab"
}

intervals {
  # Left at their defaults for the lab run except this one. The drift poll
  # would otherwise read the managed interface every five minutes and put a
  # second reader in the middle of a run whose whole point is watching one
  # write.
  drift { seconds: 3600 }
}

authentication {
  issuers {
    issuer: "https://127.0.0.1:8445/dex"
    audience: "flowseer-device"
    organization_claim_name: "groups"
  }
}

platform_admin {
  issuer: "https://127.0.0.1:8445/dex"
  organization: "flowseer-platform"
  organization_claim_name: "groups"
  subjects: "CiQwMDAwMDAwMC0wMDAwLTAwMDAtMDAwMC0wMDAwMDAwMDAwMDISBWxvY2Fs"
}

authorization {
  endpoint: "https://127.0.0.1:8081"
  store_id: "PLACEHOLDER_STORE_ID"
  model_id: "PLACEHOLDER_MODEL_ID"
  preshared_key_file: "/etc/flowseer/secrets/openfga.key"
}

# The lab's ClickHouse is the compose service on loopback. The passwords sit
# in the files the README has you write under /etc/flowseer/clickhouse. A
# single node names no cluster, so the migrator creates plain engines.
history {
  endpoints: "127.0.0.1:9000"
  database: "flowseer"
  admin {
    name: "flowseer_admin"
    password_file: "/etc/flowseer/clickhouse/admin.password"
  }
  writer {
    name: "flowseer_writer"
    password_file: "/etc/flowseer/clickhouse/writer.password"
  }
  reader {
    name: "flowseer_reader"
    password_file: "/etc/flowseer/clickhouse/reader.password"
  }
  analyst {
    name: "flowseer_analyst"
    password_file: "/etc/flowseer/clickhouse/analyst.password"
  }
}

# Sized for 1,000 devices sending one syslog message a minute and a 72 hour
# horizon: the history store may be down that long before a full stream
# refuses intake. 571 stored bytes per message (src/modules/edgebus/README.md)
# gives about 2.3 GiB, rounded up to 2.5 GiB.
# The account budget is that stream plus the audit, operator, and evidence
# streams (256 + 64 + 16 + 64 MiB), rounded up to 3 GiB.
ingest_streams {
  max_bytes_per_type: 2684354560
  central_budget_bytes: 3221225472
}
