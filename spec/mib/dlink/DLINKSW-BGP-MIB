	dBgpAggregateTable OBJECT-TYPE
		SYNTAX		SEQUENCE OF DBgpAggregateEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"BGP aggregate address table."
		::= { dBgpMIBObjects 6}

	dBgpAggregateEntry OBJECT-TYPE
		SYNTAX		DBgpAggregateEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Detail information about BGP aggregate address."
		INDEX {
			dBgpAggregateAfi,
			dBgpAggregateSafi,
			dBgpAggregateType,
			dBgpAggregatePrefix,
			dBgpAggregatePrefixLen,
			dBgpAggregateVrfName
		}
		::= {dBgpAggregateTable 1}

	DBgpAggregateEntry ::= SEQUENCE {
		dBgpAggregateAfi			INTEGER,
		dBgpAggregateSafi			INTEGER,
