--		SYNTAX		TruthValue
--		MAX-ACCESS	read-create
--		STATUS		current
--		DESCRIPTION
--			"Whether to log BGP neighbor status changes or not."
--		::= { dBgpGlobalEntry 13}

	dBgpRouterId OBJECT-TYPE
		SYNTAX		IpAddress
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Router identifier of BGP instance."
		::= { dBgpGlobalEntry 14}

	dBgpScanTime OBJECT-TYPE
		SYNTAX		Integer32(5..60)
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Time interval (in seconds) for checking whether the next hop of BGP
			routes is reachable or not."
		::= { dBgpGlobalEntry 15}

--	dBgpUpdateDelay OBJECT-TYPE
--		SYNTAX		Integer32(0..3600)
--		MAX-ACCESS	read-create
--		STATUS		current
--		DESCRIPTION
--			"Time before sending the first updates to the neighbor after the session
--			to the neighbor establish."
--		::= { dBgpGlobalEntry 16}

	dBgpDefIpv4Unicast OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"When the object is true(1), exchanging of IPv4 unicast routing information
			is automatically enabled after creating new neighbors sessions."
		::= { dBgpGlobalEntry 17}

	dBgpSync OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"BGP synchronization."
		::= { dBgpGlobalEntry 18}

	dBgpKeepalive OBJECT-TYPE
		SYNTAX		Integer32(0..65535)
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Time interval (in seconds) for sending KEEPALIVE messages."
		::= { dBgpGlobalEntry 19}

	dBgpHoldtime OBJECT-TYPE
		SYNTAX		Integer32(0..65535)
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Maximum time (in seconds) for waiting KEEPALIVE messages
			from BGP neighbors."
		::= { dBgpGlobalEntry 20}

--	dBgpMinHoldtime OBJECT-TYPE
--		SYNTAX		Integer32(0..65535)
--		MAX-ACCESS	read-create
--		STATUS		current
--		DESCRIPTION
--			"Minimum acceptable hold time from the BGP neighbors. It should
--			be less than or equal to the configured hold time."
--		::= { dBgpGlobalEntry 21}

	dBgpCtocReflection OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Whether to reflect routes from route reflector clients to other
			route reflector clients."
		::= { dBgpGlobalEntry 22}

	dBgpClusterId OBJECT-TYPE
		SYNTAX		IpAddress
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Route reflector cluster identifier."
		::= { dBgpGlobalEntry 23}

	dBgpConfedId OBJECT-TYPE
		SYNTAX		Unsigned32 (0..4294967295)
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"BGP confederation identifier. The range of the AS number is 1
			to 4294967295, except AS-TRANS (23456). Use 0 to remove the
			confederation identifier."
		::= { dBgpGlobalEntry 24}

	dBgpConfedPeers OBJECT-TYPE
		SYNTAX		DisplayString
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"BGP confederation peers."
		::= { dBgpGlobalEntry 25}

	dBgpGRRestartState OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Enable or disable to advertise the graceful restart capability."
		::= { dBgpGlobalEntry 26}

	dBgpGRRestartTime OBJECT-TYPE
		SYNTAX		Integer32(1..3600)
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Maximum time needed for neighbors to restart, in seconds."
		::= { dBgpGlobalEntry 27}

	dBgpGRStalepathTime OBJECT-TYPE
		SYNTAX		Integer32(1..3600)
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Maximum time to retain stale paths from restarting neighbors,
			in seconds."
		::= { dBgpGlobalEntry 28}

	dBgpDefaultInfoOrigin OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Control the redistribution of static default route."
		::= { dBgpGlobalEntry 29}

	dBgpGlobalRowStatus OBJECT-TYPE
		SYNTAX		RowStatus
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"This object indicates the status of this entry. Use createAndGo(4)
			to create BGP instance, use destroy(6) to delete BGP instance, and
			use active(1) to configure other parameters."
		::= { dBgpGlobalEntry 99}

