DLINKSW-BGP-MIB DEFINITIONS ::= BEGIN

	IMPORTS
		MODULE-IDENTITY,OBJECT-TYPE,
		Integer32,Unsigned32,IpAddress,
		TimeTicks							FROM SNMPv2-SMI
		TruthValue, RowStatus,
		DisplayString						FROM SNMPv2-TC
		MODULE-COMPLIANCE, OBJECT-GROUP		FROM SNMPv2-CONF
		InetAddress, InetAddressType,
		InetAddressPrefixLength				FROM INET-ADDRESS-MIB
		InterfaceIndex						FROM IF-MIB
		dlinkIndustrialCommon				FROM DLINK-ID-REC-MIB;

	dlinkSwBgpMIB MODULE-IDENTITY
		LAST-UPDATED "202003310000Z"
		ORGANIZATION    "D-Link Corp."
		CONTACT-INFO
			"        D-Link Corporation

			 Postal: No. 289, Sinhu 3rd Rd., Neihu District,
					Taipei City 114, Taiwan, R.O.C
			 Tel:     +886-2-66000123
			 E-mail: tsd@dlink.com.tw
            "
		DESCRIPTION
			"The Structure of BGP Information for the
				proprietary enterprise."
		REVISION        "201404090000Z"
		DESCRIPTION
			"Initial revision of this MIB module."

        REVISION        "201406300000Z"
        DESCRIPTION
            "Modify RowStatus objects. Update the SYNTAX of dBgpAggregateAfi.
			Remove un-supported objects."   

        REVISION        "201407030000Z"
        DESCRIPTION
            "Update the SYNTAX of dBgpNetworkAfi, dBgpRouteAfi, 
			dBgpRedistAfi, dBgpDistanceAfi ."  

        REVISION        "201408050000Z"
        DESCRIPTION
            "Update some objects." 

        REVISION        "201503100000Z"
        DESCRIPTION
            "Add isis for the node dBgpRedistProtocol.
            		Modify As to AS for some nodes."   

        REVISION        "201503250000Z"
        DESCRIPTION
            "Remove the value range of BGP distance." 

        REVISION        "201511200000Z"
        DESCRIPTION
            "Modify error-spelling words of dBgpRouteOrigin, dBgpVPNv4RouteOrigin,
            		dBgpL2VPNRouteOrigin" 

        REVISION        "201512020000Z"
        DESCRIPTION
            "Remove the node dIpExtCommunityListRule2, and modify the node dIpExtCommunityListRule1 to dIpExtCommunityListRule" 

        REVISION        "201512100000Z"
        DESCRIPTION
            "Modify the maximum rule length of dIpCommunityListRule and dIpExtCommunityListRule from 200 to 100" 

        REVISION        "201601210000Z"
        DESCRIPTION
            "Restore the objects dIpExtCommunityListRule1 and dIpExtCommunityListRule2. Set theire status to obsolete" 

        REVISION        "201805220000Z"
        DESCRIPTION
            "Add a object dBgpDefaultInfoOrigin and a table dBgpDefaultInfoTable" 

        REVISION        "201810070000Z"
        DESCRIPTION
            "Change the object dBgpDefaultInfoState from read-create to read-wirte "

        REVISION        "202003310000Z"
        DESCRIPTION
            "Add the objects dBgpPeerBfdState and dBgpPeerGroupBfdState."
		::= { dlinkIndustrialCommon 173 }

    dBgpMIBNotifications    OBJECT IDENTIFIER ::= { dlinkSwBgpMIB 0 }
	dBgpMIBObjects			OBJECT IDENTIFIER ::= { dlinkSwBgpMIB 1 }
	dBgpMIBConformance		OBJECT IDENTIFIER ::= { dlinkSwBgpMIB 2 }

	dIpASPathAccessListTable OBJECT-TYPE
		SYNTAX		SEQUENCE OF DIpASPathAccessListEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"AS path access list table."
		::= { dBgpMIBObjects 1}

	dIpASPathAccessListEntry OBJECT-TYPE
		SYNTAX		DIpASPathAccessListEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"An entry in the dIpASPathAccessListTable containing the
			detail information of the AS-path access list rule."
		INDEX {
			dIpASPathAccessListName,
			dIpASPathAccessListMatchAction,
			dIpASPathAccessListRule
		}
		::= {dIpASPathAccessListTable 1}

	DIpASPathAccessListEntry ::= SEQUENCE {
		dIpASPathAccessListName				DisplayString,
		dIpASPathAccessListMatchAction		INTEGER,
		dIpASPathAccessListRule				DisplayString,
		dIpASPathAccessListRowStatus		RowStatus
	}

	dIpASPathAccessListName OBJECT-TYPE
		SYNTAX DisplayString (SIZE(1..16))
		MAX-ACCESS not-accessible
		STATUS  current
		DESCRIPTION
			"Specify the name of the AS-path access list."
		::= { dIpASPathAccessListEntry 1}

	dIpASPathAccessListMatchAction OBJECT-TYPE
		SYNTAX INTEGER {
			permit(1),
			deny(2),
			none(3)
		}
		MAX-ACCESS not-accessible
		STATUS  current
		DESCRIPTION
			"Specify the action performed by this AS-path access list."
		::= { dIpASPathAccessListEntry 2}

	dIpASPathAccessListRule OBJECT-TYPE
		SYNTAX DisplayString (SIZE(0..80))
		MAX-ACCESS not-accessible
		STATUS  current
		DESCRIPTION
			"Specify the rule of the AS-path access list wiht a regular expression."
		::= { dIpASPathAccessListEntry 3}

	dIpASPathAccessListRowStatus OBJECT-TYPE
		SYNTAX		RowStatus
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"This object indicates the status of this entry.
			Only createAndGo(4) and destroy(6) can be set."
		::= { dIpASPathAccessListEntry 99}

	dIpCommunityListTable OBJECT-TYPE
		SYNTAX		SEQUENCE OF DIpCommunityListEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Community list table."
		::= {dBgpMIBObjects 2}

	dIpCommunityListEntry OBJECT-TYPE
		SYNTAX		DIpCommunityListEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"An entry in the DIpCommunityListTable containing the
			detail information of the communtiy list rule."
		INDEX {
			dIpCommunityListName,
			dIpCommunityListType,
			dIpCommunityListMatchAction,
			dIpCommunityListRule
		}
		::= { dIpCommunityListTable 1}

	DIpCommunityListEntry ::= SEQUENCE {
		dIpCommunityListName			DisplayString,
		dIpCommunityListType			INTEGER,
		dIpCommunityListMatchAction		INTEGER,
		dIpCommunityListRule			DisplayString,
		dIpCommunityListRowStatus		RowStatus
	}

	dIpCommunityListName OBJECT-TYPE
		SYNTAX		DisplayString (SIZE(1..16))
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Specifies the name of the community list."
		::= { dIpCommunityListEntry 1}

	dIpCommunityListType OBJECT-TYPE
		SYNTAX		INTEGER {
			standard(1),
			expanded(2)
		}
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Specifies the type of the community list."
		::= { dIpCommunityListEntry 2}

	dIpCommunityListMatchAction OBJECT-TYPE
		SYNTAX		INTEGER {
			permit(1),
			deny(2),
			none(3)
		}
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Specifies the action performed by this community list."
		::= { dIpCommunityListEntry 3}

	dIpCommunityListRule OBJECT-TYPE
		SYNTAX		DisplayString (SIZE(0..100))
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Specifies the rule of the community list. It supports three types:
			1. Community number: AA:NN
			2. Well-known communtiy, including four community: internet, local-as,
				no-advertise and no-export
			3. Regular expression.
			Type 1 and 2 are supported by standard community list.
			Type 3 is supported by expanded community list."
		::= { dIpCommunityListEntry 4}

	dIpCommunityListRowStatus OBJECT-TYPE
		SYNTAX		RowStatus
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"This object indicates the status of this entry.
			Only createAndGo(4) and destroy(6) can be set."
		::= { dIpCommunityListEntry 99}

	dIpExtCommunityListTable OBJECT-TYPE
		SYNTAX		SEQUENCE OF DIpExtCommunityListEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Extended communtiy list table."
		::= {dBgpMIBObjects 3}

	dIpExtCommunityListEntry OBJECT-TYPE
		SYNTAX		DIpExtCommunityListEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Entry containing information about the extended community list."
		INDEX {
			dIpExtCommunityListName,
			dIpExtCommunityListType,
			dIpExtCommunityListMatchAction,
			dIpExtCommunityListRule
		}
		::= { dIpExtCommunityListTable 1}

	DIpExtCommunityListEntry ::= SEQUENCE {
		dIpExtCommunityListName			DisplayString,
		dIpExtCommunityListType			INTEGER,
		dIpExtCommunityListMatchAction		INTEGER,
		dIpExtCommunityListRule1		DisplayString,
		dIpExtCommunityListRule2		DisplayString,
		dIpExtCommunityListRule			DisplayString,
		dIpExtCommunityListRowStatus		RowStatus
	}

	dIpExtCommunityListName OBJECT-TYPE
		SYNTAX		DisplayString (SIZE(1..16))
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Speicifies the name of the extended community list."
		::= { dIpExtCommunityListEntry 1}

	dIpExtCommunityListType OBJECT-TYPE
		SYNTAX		INTEGER {
			standard(1),
			expanded(2)
		}
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Specifies the type of the extended community list."
		::= { dIpExtCommunityListEntry 2}

	dIpExtCommunityListMatchAction OBJECT-TYPE
		SYNTAX		INTEGER {
			permit(1),
			deny(2),
			none(3)
		}
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Specifies the action performed by this extended community list rule."
		::= { dIpExtCommunityListEntry 3}

	dIpExtCommunityListRule1 OBJECT-TYPE
		SYNTAX		DisplayString (SIZE(0..250))
		MAX-ACCESS	not-accessible
		STATUS		obsolete
		DESCRIPTION
			"Specifies the rule of extended community list entry. It supports two types:
			1. A set of RT value or SoO value: the formate could be IP address: number and AS Number: number.
				Max 12 values are supported. The values are seperated by space.
			2. Regular expression.
			Type 1 is supported by standard extended community list.
			Type 2 is supported by expanded extended community list.
			This is the first 255 characters."
		::= { dIpExtCommunityListEntry 4}

	dIpExtCommunityListRule2 OBJECT-TYPE
		SYNTAX		DisplayString (SIZE(0..100))
		MAX-ACCESS	not-accessible
		STATUS		obsolete
		DESCRIPTION
			"Specifies the rule of extended community list entry. It supports two types:
			1. A set of RT value or SoO value: the formate could be IP address: number and AS Number: number.
				Max 12 values are supported. The values are seperated by space.
			2. Regular expression.
			Type 1 is supported by standard extended community list.
			Type 2 is supported by expanded extended community list.
			This is the last 100 charaters."
		::= { dIpExtCommunityListEntry 5}

	dIpExtCommunityListRule OBJECT-TYPE
		SYNTAX		DisplayString (SIZE(0..100))
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Specifies the rule of extended community list entry. It supports two types:
			1. A set of RT value or SoO value: the formate could be IP address: number and AS Number: number.
				Max 12 values are supported. The values are seperated by space.
			2. Regular expression.
			Type 1 is supported by standard extended community list.
			Type 2 is supported by expanded extended community list.

			Due to the SNMP limitation, the rule can only support 100
			characters. Rules exceeded 100 characters are ignored when
			display."
		::= { dIpExtCommunityListEntry 6}

	dIpExtCommunityListRowStatus OBJECT-TYPE
		SYNTAX		RowStatus
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"This object indicates the status of this entry.
			Only createAndGo(4) and destroy(6) can be set."
		::= { dIpExtCommunityListEntry 99}

	dBgpGlobalTable OBJECT-TYPE
		SYNTAX		SEQUENCE OF DBgpGlobalEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Table of BGP global parameters. Used to create and delete BGP
			instance, and configure BGP global parameters."
		::= { dBgpMIBObjects 4}

	dBgpGlobalEntry OBJECT-TYPE
		SYNTAX		DBgpGlobalEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"Detail information of BGP global parameters."
		INDEX {
			dBgpLocalAS
		}
		::= { dBgpGlobalTable 1}

	DBgpGlobalEntry ::= SEQUENCE {
		dBgpLocalAS					Unsigned32,
		dBgpAggrNhopChk				TruthValue,
		dBgpAlwaysCmpMed			TruthValue,
		dBgpASPathIgnore			TruthValue,
		dBgpCmpConfedASPath			TruthValue,
		dBgpCmpRouterid				TruthValue,
		dBgpMedConfed				TruthValue,
		dBgpMedMissWorst			TruthValue,
		dBgpDefLocalPref			Unsigned32,
		dBgpDeterministicMed		TruthValue,
		dBgpEnforceFirstAS			TruthValue,
		dBgpFastExternalFailover	TruthValue,
--		dBgpLogNeighborChange		TruthValue,
		dBgpRouterId				IpAddress,
		dBgpScanTime				Integer32,
--		dBgpUpdateDelay				Integer32,	
		dBgpDefIpv4Unicast			TruthValue,
		dBgpSync					TruthValue,
		dBgpKeepalive				Integer32,
		dBgpHoldtime				Integer32,
--		dBgpMinHoldtime				Integer32,
		dBgpCtocReflection			TruthValue,
		dBgpClusterId				IpAddress,
		dBgpConfedId				Unsigned32,
		dBgpConfedPeers				DisplayString,
		dBgpGRRestartState			TruthValue,
		dBgpGRRestartTime			Integer32,
		dBgpGRStalepathTime			Integer32,
		dBgpDefaultInfoOrigin			TruthValue,
		dBgpGlobalRowStatus			RowStatus
	}

	dBgpLocalAS OBJECT-TYPE
		SYNTAX		Unsigned32 (1..4294967295)
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"The AS number of local BGP instance. The AS number can not be
			AS-TRANS(23456)."
		::= { dBgpGlobalEntry 1}

	dBgpAggrNhopChk OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Enable or disable the checking of next hop of the BGP
			aggregated routes."
		::= { dBgpGlobalEntry 2}
		
	dBgpAlwaysCmpMed OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Enable or disable to always compare MED attribute if the
			routes are learned from different neighbors."
		::= { dBgpGlobalEntry 3}

	dBgpASPathIgnore OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Whether to ignore the AS-path attribute when select the
			best routes."
		::= { dBgpGlobalEntry 4}

	dBgpCmpConfedASPath OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Whether to compare the confederation AS-path attribute when
			select the best routes."
		::= { dBgpGlobalEntry 5}

	dBgpCmpRouterid OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Whether to compare the router-id when select the best routes."
		::= { dBgpGlobalEntry 6}

	dBgpMedConfed OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Whether to compare MED among confederation peers when select the best routes."
		::= { dBgpGlobalEntry 7}

	dBgpMedMissWorst OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Whether to treat the routes without MED attribute as the worst
			routes when select the best routes."
		::= { dBgpGlobalEntry 8}

	dBgpDefLocalPref OBJECT-TYPE
		SYNTAX		Unsigned32 (0..4294967295)
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"The defalut local preference value."
		::= { dBgpGlobalEntry 9}

	dBgpDeterministicMed OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Whether to compare the MED attributes for paths from neighboring AS."
		::= { dBgpGlobalEntry 10}

	dBgpEnforceFirstAS OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Indicates whether the first AS of routes leanred from eBGP neighbor
			must be the AS of the neighbor."
		::= { dBgpGlobalEntry 11}

	dBgpFastExternalFailover OBJECT-TYPE
		SYNTAX		TruthValue
		MAX-ACCESS	read-create
		STATUS		current
		DESCRIPTION
			"Whether to reset the eBGP session immediately if interface goes down."
		::= { dBgpGlobalEntry 12}

