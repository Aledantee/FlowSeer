	        inter(2),
	        extern1(3),
	        extern2(4)
	    }
	    MAX-ACCESS	    not-accessible
	    STATUS		    current
	    DESCRIPTION
	       "This object indicates the type of the distance."
	    ::= { dOspfv2DistanceEntry 1 }

	dOspfv2Distance OBJECT-TYPE
	    SYNTAX          Integer32
	    MAX-ACCESS      read-write
	    STATUS          current
	    DESCRIPTION
	        "This object indicates the administrative distance of the entry.
	        The default value depends on the protocol type:
	        Type        Distance
	        =========   ========
	        intra       80
	        inter       90
	        extern1     110
	        extern2     115
	            "
	    ::= { dOspfv2DistanceEntry 2 }
 
