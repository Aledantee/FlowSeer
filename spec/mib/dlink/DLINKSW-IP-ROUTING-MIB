            dIpRoutingPfxLstDescrPfxAddrType,
            dIpRoutingPfxLstDescrLstName        
        }
        ::= { dIpRoutingPfxLstDescrTable 1 }

    DIpRoutingPfxLstDescrEntry ::=        SEQUENCE {
        dIpRoutingPfxLstDescrPfxAddrType    InetAddressType,
        dIpRoutingPfxLstDescrLstName        DisplayString,        
        dIpRoutingPfxLstDescrContent        DisplayString,
		dIpRoutingPfxLstDescrRowStatus      RowStatus
    }

    dIpRoutingPfxLstDescrPfxAddrType OBJECT-TYPE
        SYNTAX		    InetAddressType
        MAX-ACCESS	    not-accessible
        STATUS		    current
        DESCRIPTION
           "This object indicates the address type of the prefix list."
        ::= { dIpRoutingPfxLstDescrEntry 1 }

    dIpRoutingPfxLstDescrLstName OBJECT-TYPE
        SYNTAX		    DisplayString (SIZE (1..32))
        MAX-ACCESS	    not-accessible
        STATUS		    current
        DESCRIPTION
           "This object indicates the name of the prefix list."
        ::= { dIpRoutingPfxLstDescrEntry 2 }

    dIpRoutingPfxLstDescrContent OBJECT-TYPE
        SYNTAX		    DisplayString 
        MAX-ACCESS	    read-create
        STATUS		    current
        DESCRIPTION
           "Specify the description for prefix list."
