    dMplsCompliances	OBJECT IDENTIFIER		::= { dMplsMIBConformance 1 }
    dMplsGroups			OBJECT IDENTIFIER		::= { dMplsMIBConformance 2 }  
    
	dMplsCompliance MODULE-COMPLIANCE
        STATUS          current
        DESCRIPTION
            "The compliance statement for entities which implement the 
            DLINKSW-MPLS-MIB."
        MODULE          -- this module
        MANDATORY-GROUPS    {   
            dMplsBasicCfgGroup
        }
        
        GROUP dMplsLspGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            the MPLS LSP."
            
        GROUP dMplsQosGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            the management of MPLS QoS."
            
        GROUP dMplsLdpGlobalGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            the management of MPLS LDP global."
        
        GROUP dMplsLdpInterfaceGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            the management of MPLS LDP interface."    
        
        GROUP dMplsLdpStaticTargetedPeerGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            the management of MPLS LDP static targeted peer."
        
        GROUP dMplsLdpLspTriggerGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            the management of MPLS LDP LSP trigger."
        
        GROUP dMplsLdpNeighborPasswordGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            the management of MPLS LDP neighbor password."    
        
        ::= { dMplsCompliances 1 }
        
        dMplsBasicCfgGroup OBJECT-GROUP
        OBJECTS { 
            dMplsGlobalState,
            dMplsTrapState,
            dMplsLabelMin,
            dMplsLabelMax,
            dMplsStaticLabelMin,
            dMplsStaticLabelMax,
            dMplsInterfaceAdminState
        }           
        STATUS current
        DESCRIPTION 
            "A collection of objects providing the information and 
            control for configuring MPLS basic feature."
        ::= { dMplsGroups 1 }
        
        dMplsLspGroup OBJECT-GROUP
        OBJECTS {
            dMplsStaticLspID,
            dMplsStaticLspType,
            dMplsStaticLspFecIpType,
            dMplsStaticLspFecIpAddr,
            dMplsStaticLspFecIpMask,
            dMplsStaticLspInlabel,
            dMplsStaticLspOutlabel,
            dMplsStaticLspNextHopAddrType,
            dMplsStaticLspNextHopAddr,
            dMplsStaticLspRowStatus,
			dMplsLspID,
			dMplsLspType,
			dMplsLspFecIpType,
			dMplsLspFecIpAddr,
			dMplsLspFecIpAddrMask,
			dMplsLspInlabel,
			dMplsLspOutlabel,
			dMplsLspNextHopAddrType,
			dMplsLspNextHopAddr,
			dMplsLspOutInterfaceId,
			dMplsLspOwner            
        }           
        STATUS current
        DESCRIPTION 
            "A collection of objects providing the information 
            and control for configuring MPLS LSP feature."
        ::= { dMplsGroups 2 }
        
        dMplsQosGroup OBJECT-GROUP
        OBJECTS {
			dMplsQosPolicyExpToCosState,
			dMplsQosPolicyExpToCos,
			dMplsQosPolicyTrustExp,
			dMplsQosPolicyCosToExpState,
			dMplsQosPolicyCosToExp,
			dMplsQosPolicyRowStatus,
			dMplsQosMatchIPFecRowStatus,
			dMplsQosMatchVCRowStatus
        }           
        STATUS current
        DESCRIPTION 
            "A collection of objects providing the information and 
            control for configuring MPLS QoS feature."
        ::= { dMplsGroups 3 }
        
        dMplsLdpGlobalGroup OBJECT-GROUP
        OBJECTS { 
            dMplsLdpLsrIdKind,
			dMplsLdpLsrId,
			dMplsLdpTrapState,
			dMplsLdpTransportAddrKind,
			dMplsLdpTransportAddr,
			dMplsLdpLspControlMode,
			dMplsLdpBackOffInitTime,
			dMplsLdpBackOffMaxTime,
			dMplsLdpLinkHelloInterval,
			dMplsLdpLoopDetection,
			dMplsLdpPhp,
			dMplsLdpMd5Authentication,
			dMplsLdpGRState,
			dMplsLdpGRMaxRecoveryTime,
			dMplsLdpGRNeighborLivenessTime,
			dMplsLdpDiscoveryHelloAddrKind,
			dMplsLdpDiscoveryHelloAddr
		}           
        STATUS current
        DESCRIPTION 
            "A collection of objects providing the information and 
            control for configuring MPLS LDP global feature."
        ::= { dMplsGroups 4 }
        
        dMplsLdpInterfaceGroup OBJECT-GROUP
        OBJECTS {
			dMplsLdpInterfaceAdminState,      
			dMplsLdpInterfaceDistribution,    
			dMplsLdpInterfaceHelloInterval,   
			dMplsLdpInterfaceHelloHoldTime,   
			dMplsLdpInterfaceTargetHelloAccept
		}           
        STATUS current
        DESCRIPTION 
            "A collection of objects providing the information and 
            control for configuring MPLS LDP interface feature."
        ::= { dMplsGroups 5 }
        
        dMplsLdpStaticTargetedPeerGroup OBJECT-GROUP
        OBJECTS {
			dMplsLdpStaticTargetedPeerHelloInterval,
			dMplsLdpStaticTargetedPeerHelloHoldTime,
			dMplsLdpStaticTargetedPeerRowStatus,
			dMplsLdpStaticTargetedPeerDiscoveryHelloAddrKind,
			dMplsLdpStaticTargetedPeerDiscoveryHelloAddr
		}           
        STATUS current
        DESCRIPTION 
            "A collection of objects providing the information and 
            control for configuring MPLS LDP static targeted peer feature."
        ::= { dMplsGroups 6 }
        
        dMplsLdpLspTiggerGroup OBJECT-GROUP
        OBJECTS { 
			dMplsLdpLspTriggerAction,
			dMplsLdpLspTriggerFecIpType,
			dMplsLdpLspTriggerFecIpAddr,
			dMplsLdpLspTriggerFecIpMask,
			dMplsLdpLspTriggerRowStatus
		}           
        STATUS current
        DESCRIPTION 
            "A collection of objects providing the information 
            and control for configuring MPLS LDP LSP trigger feature."
        ::= { dMplsGroups 7 }    
        
        dMplsLdpNeighborPasswordGroup OBJECT-GROUP
        OBJECTS {
            dMplsLdpNeighborPassword,
            dMplsLdpNeighborPasswordRowStatus
		}           
        STATUS current
        DESCRIPTION 
            "A collection of objects providing the information 
            and control for configuring MPLS LDP neighbor password."
        ::= { dMplsGroups 8 }
END



