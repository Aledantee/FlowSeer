    dMplsLdpMd5Authentication OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates whether the MPLS authentication function 
            is enabled."
        ::= { dMplsLdpGlobalMgmt 12 } 
        
	dMplsLdpGRState OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "Indicates whether the MPLS LDP graceful restart is enabled. 
            The graceful restart will be used by the LDP session only 
            when both local and peer are enabled."
        ::= { dMplsLdpGlobalMgmt 13 }

	dMplsLdpGRMaxRecoveryTime OBJECT-TYPE
        SYNTAX          Unsigned32 (12..600)
        UNITS       	"seconds"
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "The max recovery time for the MPLS LDP graceful restart. 
            If LDP Graceful Restart is enabled and a LDP session 
            re-established, the device shall complete the exchange of 
            the label mapping information with its neighbor within the 
            Recovery Time. After the Recovery Timer expired, the device 
            shall delete all label forwarding entries that are marked 
            stale."      
        DEFVAL			{ 300 }
        ::= { dMplsLdpGlobalMgmt 14 }   

    dMplsLdpGRNeighborLivenessTime OBJECT-TYPE
        SYNTAX          Unsigned32 (5..300)
        UNITS       	"seconds"
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "The neighbor liveness time for the MPLS LDP graceful restart.
            If the LDP session cannot be established within the reconnection 
            time, all associated stale label forwarding entries shall be 
            deleted."                                     
        DEFVAL			{ 120 }
        ::= { dMplsLdpGlobalMgmt 15 }

