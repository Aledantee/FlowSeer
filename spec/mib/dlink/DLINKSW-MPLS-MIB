	dMplsLdpGlobalMgmt		OBJECT IDENTIFIER ::= { dMplsLdp 1 }   				
                
    dMplsLdpLsrIdKind OBJECT-TYPE
        SYNTAX          INTEGER {
        	auto(1),
        	manual(2)
        }
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the LSR ID kind for MPLS LDP.
            auto	- LDP will auto select the router ID. If LDP is running, 
            		LSR ID will not be auto-changed.
            manual	- Specifies the IPv4 address that will be used as LSR ID. 
            		The IPv4 address must be an IP address of an existed 
            		interface"
        ::= { dMplsLdpGlobalMgmt 1 }   

	dMplsLdpLsrId OBJECT-TYPE
        SYNTAX          InetAddress
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the LSR ID for MPLS LDP, is used to identify 
            the LSR in the MPLS network. Recommend set the LSR ID to the IP address 
            of a loopback interface."
        ::= { dMplsLdpGlobalMgmt 2 }

    dMplsLdpTrapState OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the trap state for MPLS LDP."
        ::= { dMplsLdpGlobalMgmt 3 }
	
	dMplsLdpTransportAddrKind OBJECT-TYPE
        SYNTAX          INTEGER {
			lsrid(1),
			interface(2),
			ipaddress(3)
		}
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the transport address kind for MPLS LDP. 
            The transport address is used to establish LDP TCP connection.
            lsrid 	  - The address of LSR ID is used as transport address 
            			by all interfaces.
            interface - The IP address of each interface is used as the 
            			transport address.
            ipaddress - The address is used as transport address by all 
            			interfaces."
        ::= { dMplsLdpGlobalMgmt 4 } 

	dMplsLdpTransportAddr OBJECT-TYPE
        SYNTAX          InetAddress
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the transport address for MPLS LDP."
        ::= { dMplsLdpGlobalMgmt 5 }   

    dMplsLdpLspControlMode OBJECT-TYPE
        SYNTAX          INTEGER {
			ordered(1),
			independent(2)
		}
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the LSP control mode for MPLS LDP. 
            ordered		- A LSR only binds a label to a FEC if it is the 
            			egress LSR for that FEC, or if it has already 
            			received a label binding for that FEC from its 
            			next hop for that FEC.
            independent - Each LSR independently binds a label to a FEC 
            			and distributes the binding to its label distribution 
            			peers."
        ::= { dMplsLdpGlobalMgmt 6 }

