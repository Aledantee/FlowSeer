                              faulty(2),
                              disabled(3),
                              listening(4),
                              pre-master(5),
                              master(6),
                              passive(7),
                              uncalibrated(8),
                              slave(9)
                          }
        MAX-ACCESS        read-only
        STATUS            current
        DESCRIPTION
            "This indicates the port role."
        ::= { dPTPBoundaryPortInfoEntry 1 }

    dPTPBoundaryPortDM  OBJECT-TYPE
	    SYNTAX          INTEGER
	                    {
                            e2e(1),
                            p2p(2)
                        }
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This indicates the propagation delay measuring mechanism."
        ::= { dPTPBoundaryPortInfoEntry 2 }

    dPTPBoundaryPortAI  OBJECT-TYPE
	    SYNTAX          INTEGER
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This indicates the mean time interval between successive
            announce messages."
        ::= { dPTPBoundaryPortInfoEntry 3 }

    dPTPBoundaryPortART  OBJECT-TYPE
	    SYNTAX           INTEGER
        MAX-ACCESS       read-only
