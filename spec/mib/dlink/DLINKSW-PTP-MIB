-- -----------------------------------------------------------------------------
    dPTPGeneralGroup		OBJECT IDENTIFIER ::= { dPTPMIBObjects 1 }
    
    dPTPState           OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object is used to indicate the global state of PTP."
        DEFVAL          { false }
        ::= { dPTPGeneralGroup 1 }
    
    dPTPMode            OBJECT-TYPE
        SYNTAX          INTEGER
                        {
                          boundary(1),
                          p2p-transparent(2),
                          e2e-transparent(3)
                        }
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object is used to indicate the switch's PTP device type."
        DEFVAL          {e2e-transparent}
        ::= { dPTPGeneralGroup 2 }
   
    dPTPTransportProtocol      OBJECT-TYPE
        SYNTAX          INTEGER
                        {
                          udp(1),
                          ethernet(2)
                        }
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object is used to indicate the transport protocol that will
            be used for the communication path."
        DEFVAL          {udp}
        ::= { dPTPGeneralGroup 3 }
    
    dPTPBoundaryPriority1      OBJECT-TYPE
        SYNTAX          INTEGER (0..255)
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object is used to indicate the PTP boundary clock attributes.
            The priority 1 attribute is used in the execution of the best master
            clock algorithm. Lower values take precedence."
        DEFVAL          {128}
        ::= { dPTPGeneralGroup 4 }
    
    dPTPBoundaryPriority2      OBJECT-TYPE
        SYNTAX          INTEGER (0..255)
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object is used to indicate the PTP boundary clock attributes.
            The priority 2 attribute is used in the execution of the best master
            clock algorithm. Lower values take precedence.
            
            In the event that the operation of the BMC algorithm fails to order
            the clocks based on the values of priority1, the clock's class,
            and the clock's accuracy; the priority2 attribute will allow the
            creation of lower values compared to the other devices."
        DEFVAL          {128}
        ::= { dPTPGeneralGroup 5 }
    	
     dPTPClockDomainNumber  OBJECT-TYPE
        SYNTAX              INTEGER (0..127)
        MAX-ACCESS          read-write
        STATUS              current
        DESCRIPTION
            "This indicates the PTP clock common attribute of
            the domain number."
        DEFVAL              {0}
        ::= { dPTPGeneralGroup 6 }

     dPTPClockDomainName  OBJECT-TYPE
        SYNTAX            DisplayString (SIZE (0..32))
        MAX-ACCESS        read-write
        STATUS            current
        DESCRIPTION
            "This indicates the domain name of dPTPClockDomainNumber."
        ::= { dPTPGeneralGroup 7 }

-- -----------------------------------------------------------------------------
    dPTPPortCFG		OBJECT IDENTIFIER ::= { dPTPMIBObjects 2 }
    
    dPTPPortTable       OBJECT-TYPE
        SYNTAX          SEQUENCE OF DPTPPortEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This table contains the per port state of the PTP clock."
        ::= { dPTPPortCFG 1 }
    
    dPTPPortEntry           OBJECT-TYPE
        SYNTAX              DPTPPortEntry
        MAX-ACCESS          not-accessible
        STATUS              current
        DESCRIPTION
            "This is an entry of the dPTPPortTable."
        INDEX               { ifIndex }
        ::= { dPTPPortTable 1 }
        
    DPTPPortEntry ::=
        SEQUENCE {
            dPTPPortState
                TruthValue
        }
    	
     dPTPPortState   OBJECT-TYPE
         SYNTAX      TruthValue
         MAX-ACCESS  read-write
         STATUS      current
         DESCRIPTION
             "This indicates the port state of the PTP clock."
         ::= { dPTPPortEntry 1 }
     
     dPTPBoundaryPortCFGTable   OBJECT-TYPE
         SYNTAX                 SEQUENCE OF DPTPBoundaryPortCFGEntry
         MAX-ACCESS             not-accessible
         STATUS                 current
         DESCRIPTION
             "This table contains the per port attributes of the PTP
             boundary clock.
             These attributes takes effect when the PTP device type is boundary."
         ::= { dPTPPortCFG 2 }

     dPTPBoundaryPortCFGEntry   OBJECT-TYPE
         SYNTAX                 DPTPBoundaryPortCFGEntry
         MAX-ACCESS             not-accessible
         STATUS                 current
         DESCRIPTION
             "This is an entry of the dPTPBoundaryPortTable."
         INDEX  { ifIndex }
         ::= { dPTPBoundaryPortCFGTable 1 }

     DPTPBoundaryPortCFGEntry ::=
         SEQUENCE {
             dPTPBoundaryPortAnnounceInterval
                 INTEGER,
             dPTPBoundaryPortAnnounceTimeout
                 INTEGER,
             dPTPBoundaryPortSyncInterval
                 INTEGER,
             dPTPBoundaryPortDelayReqInterval
                 INTEGER,
             dPTPBoundaryPortPDelayReqInterval
                 INTEGER,
             dPTPBoundaryPortDelayMechanism
                 INTEGER
         }
       	
     dPTPBoundaryPortAnnounceInterval  OBJECT-TYPE
	     SYNTAX  INTEGER               (1..16)
         MAX-ACCESS                    read-write
         STATUS                        current
         DESCRIPTION
             "This indicates the mean time interval between successive
             announce messages.
            In line with the IEEE1588 protocol, the value of the announce
            interval will be represented as the logarithm to base 2 of
            this time measured in seconds. The range is 1-16, so the import
            value must either be 1, 2, 4, 8, or 16. If the input is not allowed,
            then the input should be automatically adjusted to allow the biggest
            and closest value."
         ::= { dPTPBoundaryPortCFGEntry 1 }

     dPTPBoundaryPortAnnounceTimeout  OBJECT-TYPE
	     SYNTAX  INTEGER              (2..10)
         MAX-ACCESS                   read-write
         STATUS                       current
         DESCRIPTION
             "This indicates the announce interval number that has to pass
             without receipt of an Announce message before the occurrence
             of the ANNOUNCE_RECEIPT_TIMEOUT_EXPIRES event.
             This value multiplied by the announce interval value is equal
             to the interval time of the announce receipt timeout."
         ::= { dPTPBoundaryPortCFGEntry 2 }

     dPTPBoundaryPortSyncInterval  OBJECT-TYPE
	     SYNTAX                    INTEGER
	                               {
	                                   half-second(1),
	                                   one-second(2),
	                                   two-second(3)
	                               }
         MAX-ACCESS                read-write
         STATUS                    current
         DESCRIPTION
             "This indicates the mean time interval between successive
             Sync messages.
             In line with the IEEE1588 protocol, the value of the sync interval
             shall be represented as the logarithm to base 2 of this time
             measured in seconds. So the import value must either be 0.5, 1 or 2."
         ::= { dPTPBoundaryPortCFGEntry 3 }

     dPTPBoundaryPortDelayReqInterval  OBJECT-TYPE
	     SYNTAX                        INTEGER (0..5)
         MAX-ACCESS                    read-write
         STATUS                        current
         DESCRIPTION
             "This indicates the permitted mean time interval between
             successive delay request messages which are sent by a slave to
             a specific port on the master.
             In line with the IEEE1588 protocol, the value of delay req interval
             shall be an exponent of 2. In addition, this interval shall be an
             integer with the minimum value being sync interval, and the maximum
             value being 32 times the sync interval value. The actual range of the
             allowed exponent of the interval delay request is
             [logSyncInterval+0, logSyncInterval+5].
             If the sync interval is half a second and the delay req interval is 0,
             then the permitted time interval between successive delay request
             messages will be automatically adjusted to one second."
         ::= { dPTPBoundaryPortCFGEntry 4 }

     dPTPBoundaryPortPDelayReqInterval  OBJECT-TYPE
	     SYNTAX                         INTEGER (1..32)
         MAX-ACCESS                     read-write
         STATUS                         current
         DESCRIPTION
             "This indicates the permitted mean time interval between
             successive pdelay request messages.
             In line with the IEEE1588 protocol, the value of pdelay req interval
             shall be represented as the logarithm to base 2 of this time measured
             in seconds. The range is 1-32, so the import value must be either
             1, 2, 4, 8, 16 or 32. If the input is not allowed, then the input
             will be automatically adjusted to allow for the bigger and closest value."
         ::= { dPTPBoundaryPortCFGEntry 5 }

     dPTPBoundaryPortDelayMechanism  OBJECT-TYPE
	     SYNTAX                      INTEGER
	                                 {
                                         e2e(1),
                                         p2p(2)
                                     }
         MAX-ACCESS                  read-write
         STATUS                      current
         DESCRIPTION
             "This indicates the mechanism for measuring the propagation
             delay time of an event message.
             e2e: End-to-End indicates that the port is configured to use the delay
             request-response mechanism.
             p2p: Peer-to-Peer is the peer delay mechanism"
         ::= { dPTPBoundaryPortCFGEntry 6 }
     
     dPTPp2pTransparentPortCFGTable  OBJECT-TYPE
         SYNTAX                      SEQUENCE OF DPTPp2pTransparentPortCFGEntry
         MAX-ACCESS                  not-accessible
         STATUS                      current
         DESCRIPTION
             "This table contains the per port attribute for the P2P
             transparent clock."
         ::= { dPTPPortCFG 3 }

     dPTPp2pTransparentPortCFGEntry  OBJECT-TYPE
         SYNTAX                      DPTPp2pTransparentPortCFGEntry
         MAX-ACCESS                  not-accessible
         STATUS                      current
         DESCRIPTION
             "This is an entry of the dPTPPortTable."
         INDEX  { ifIndex }
         ::= { dPTPp2pTransparentPortCFGTable 1 }

     DPTPp2pTransparentPortCFGEntry ::=
         SEQUENCE {
             dPTPp2pTransparentPortPDelayReqInterval
                 INTEGER
         }

     dPTPp2pTransparentPortPDelayReqInterval  OBJECT-TYPE
	     SYNTAX                               INTEGER (1..32)
         MAX-ACCESS                           read-write
         STATUS                               current
         DESCRIPTION
             "This indicates the permitted mean time interval between
             successive pdelay request messages.
             In line with the IEEE1588 protocol, the value of the pdelay req interval
             shall be represented as the logarithm to base 2 of this time measured
             in seconds. The range is 1-32, so the import value must be either
             1, 2, 4, 8, 16 or 32. If the input is not allowed, then the input
             will be automatically adjusted to allow the biggest and closest value."
         ::= { dPTPp2pTransparentPortCFGEntry 1 }

