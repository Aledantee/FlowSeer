    dPTPClock		OBJECT IDENTIFIER ::= { dPTPMIBObjects 4 }
    
    dPTPBoundaryClockTable  OBJECT-TYPE
        SYNTAX              SEQUENCE OF DPTPBoundaryClockEntry
        MAX-ACCESS          not-accessible
        STATUS              current
        DESCRIPTION
            "This table contains the per unit information of
            PTP boundary clock."
        ::= { dPTPClock 1 }

    dPTPBoundaryClockEntry  OBJECT-TYPE
        SYNTAX               DPTPBoundaryClockEntry
        MAX-ACCESS           not-accessible
        STATUS               current
        DESCRIPTION
            "This is an entry of the dPTPBoundaryClockTable."
        INDEX  { dPTPUnit }
        ::= { dPTPBoundaryClockTable 1 }

    DPTPBoundaryClockEntry ::=
        SEQUENCE {
            dPTPUnit
                INTEGER,
            dPTPBoundaryClockIdentity
                OCTET STRING,
            dPTPBoundaryClockClass
                INTEGER,
            dPTPBoundaryClockStepsRemoved
                INTEGER,
            dPTPBoundaryClockLastOffset
                DisplayString,
            dPTPBoundaryClockMeanPathDelay
                DisplayString,
            dPTPBoundaryClockEnabledPorts
                PortList
        }
    
    dPTPUnit	    OBJECT-TYPE
    	SYNTAX      INTEGER
    	MAX-ACCESS  not-accessible
    	STATUS      current
    	DESCRIPTION
            "This indicates the PTP unit number."
    	::= { dPTPBoundaryClockEntry 1  }
    
    dPTPBoundaryClockIdentity  OBJECT-TYPE
        SYNTAX                 OCTET STRING (SIZE (8))
        MAX-ACCESS             read-only
        STATUS                 current
        DESCRIPTION
            "This indicates the PTP boundary clock identity.
            8-octet array, The first 3 octets of the MAC address are assigned
            in order to the first 3 octets of the clockIdentity. Octets with
            index 3 and 4 are respectively assigned hex values FF and FE.
            The remaining 3 octets of the MAC address are assigned in order
            to the last 3 octets of the clockIdentity."
        ::= { dPTPBoundaryClockEntry 2 }

    dPTPBoundaryClockClass  OBJECT-TYPE
        SYNTAX              INTEGER
        MAX-ACCESS          read-only
        STATUS              current
        DESCRIPTION
            "This indicates the PTP boundary clock class."
        ::= { dPTPBoundaryClockEntry 3 }

    dPTPBoundaryClockStepsRemoved  OBJECT-TYPE
        SYNTAX                     INTEGER
        MAX-ACCESS                 read-only
        STATUS                     current
        DESCRIPTION
            "This indicates the number of communication paths traversed
            between the local clock and the grandmaster clock."
        ::= { dPTPBoundaryClockEntry 4 }

    dPTPBoundaryClockLastOffset  OBJECT-TYPE
        SYNTAX                   DisplayString
        MAX-ACCESS               read-only
        STATUS                   current
        DESCRIPTION
            "This indicates the time offset between a master and a slave
            as computed by the slave."
        ::= { dPTPBoundaryClockEntry 5 }

    dPTPBoundaryClockMeanPathDelay  OBJECT-TYPE
        SYNTAX                      DisplayString
        MAX-ACCESS                  read-only
        STATUS                      current
        DESCRIPTION
            "This indicates the mean propagation time between a master and
            a slave clock as computed by the slave."
        ::= { dPTPBoundaryClockEntry 6 }
    
    dPTPBoundaryClockEnabledPorts  OBJECT-TYPE
        SYNTAX                     PortList
        MAX-ACCESS                 read-only
        STATUS                     current
        DESCRIPTION
            "This indicates the PTP boundary clock enabled ports."
        ::= { dPTPBoundaryClockEntry 7 }
    
    dPTPTransparentClockTable  OBJECT-TYPE
        SYNTAX                 SEQUENCE OF DPTPTransparentClockEntry
        MAX-ACCESS             not-accessible
        STATUS                 current
        DESCRIPTION
            "This table contains the per unit information of
            PTP transparent clock."
        ::= { dPTPClock 2 }

    dPTPTransparentClockEntry  OBJECT-TYPE
        SYNTAX                 DPTPTransparentClockEntry
        MAX-ACCESS             not-accessible
        STATUS                 current
        DESCRIPTION
            "This is an entry of the dPTPTransparentClockTable."
        INDEX  { dPTPUnit }
        ::= { dPTPTransparentClockTable 1 }

    DPTPTransparentClockEntry ::=
        SEQUENCE {
            dPTPTransparentClockDelayMechanism
                INTEGER,
            dPTPTransparentClockIdentity
                OCTET STRING,
            dPTPTransparentClockEnabledPorts
                PortList
        }

    dPTPTransparentClockDelayMechanism  OBJECT-TYPE
        SYNTAX                          INTEGER
                                        {
                                            e2e(1),
                                            p2p(2)
                                        }
        MAX-ACCESS                      read-only
        STATUS                          current
        DESCRIPTION
            "This indicates the PTP transparent clock mode."
        ::={ dPTPTransparentClockEntry 1 }

    dPTPTransparentClockIdentity  OBJECT-TYPE
        SYNTAX                    OCTET STRING (SIZE (8))
        MAX-ACCESS                read-only
        STATUS                    current
        DESCRIPTION
            "This indicates the PTP clock identity.
            8-octet array, The first 3 octets of the MAC address are assigned
            in order to the first 3 octets of the clockIdentity. Octets with
            index 3 and 4 are respectively assigned hex values FF and FE.
            The remaining 3 octets of the MAC address are assigned in order
            to the last 3 octets of the clockIdentity."
        ::= { dPTPTransparentClockEntry 2 }
        
    dPTPTransparentClockEnabledPorts  OBJECT-TYPE
        SYNTAX                        PortList
        MAX-ACCESS                    read-only
        STATUS                        current
        DESCRIPTION
            "This indicates the PTP transparent clock enabled ports."
        ::={ dPTPTransparentClockEntry 3 }

