    // meta
    organization "HPE-ANW";
    contact
        "HPE-ANW, Inc.
        Customer Service
        Postal: 6280 America Center Dr,
        Alviso, CA 95002, United States";
    description
        "This module contains HPE-ANW AOS-CX OpenConfig deviations for all modules";

    revision 2025-11-07 {
        description "Initial revision";
    }

