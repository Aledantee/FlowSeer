module hpe-anw-cx-openconfig-deviations {
    yang-version "1";
    namespace "http://arubanetworks.com/yang/cx/openconfig/deviations";
    prefix "oc-dev";

    import ietf-interfaces { prefix if; }
    import openconfig-acl { prefix oc-acl; }
    import openconfig-bfd { prefix oc-bfd; }
    import openconfig-defined-sets { prefix oc-sets; }
    import openconfig-interfaces { prefix oc-if; }
