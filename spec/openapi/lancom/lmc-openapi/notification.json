              "$ref" : "#/components/schemas/ErrorResponseBody"
            }
          }
        }
      }
    },
    "parameters" : {
      "AccountId" : {
        "name" : "accountId",
        "in" : "path",
        "required" : true,
        "schema" : {
          "type" : "string",
          "format" : "uuid"
        }
      },
      "AlertId" : {
        "name" : "alertId",
        "in" : "path",
        "required" : true,
        "schema" : {
          "type" : "string",
          "format" : "uuid"
        }
      },
      "AlertType" : {
        "name" : "type",
        "in" : "path",
        "required" : true,
        "schema" : {
          "type" : "string"
        }
      },
      "NotificationLanguage" : {
        "name" : "lang",
        "in" : "query",
        "description" : "Language used for notification translation",
        "schema" : {
          "type" : "string",
          "enum" : [ "DE", "EN", "de", "en" ],
          "default" : "EN"
        }
      },
      "NotificationStates" : {
        "name" : "states",
        "in" : "query",
        "description" : "Filters the notification by their state.",
        "style" : "form",
        "explode" : true,
        "schema" : {
          "type" : "array",
          "items" : {
            "type" : "string",
            "enum" : [ "open", "closed" ]
          }
        }
      },
      "PaginationNextChunkMark" : {
        "name" : "mark",
        "in" : "query",
        "description" : "Generic key to pass the value to the backend for pagination.",
        "schema" : {
          "type" : "string"
        }
      },
      "PaginationNextChunkSize" : {
        "name" : "limit",
        "in" : "query",
        "description" : "Limit of the result size. Default value is defined in the backend. This is used to override the default value.",
        "schema" : {
          "maximum" : 200,
          "type" : "integer"
        }
      },
      "TOKEN" : {
        "name" : "Authorization",
        "in" : "header",
        "description" : "JWT based Session token",
        "required" : false,
        "schema" : {
          "type" : "string"
        }
      }
    },
    "securitySchemes" : {
      "apiKey" : {
        "type" : "apiKey",
        "in" : "header",
        "name" : "Authorization",
        "description" : "Provide an API key for 'Authorization: LMC-API-KEY {value}' header format."
      },
      "basic" : {
        "type" : "http",
        "scheme" : "basic",
        "description" : "Provide a username and password. Account IDs may be set optionally."
      },
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT",
        "description" : "Provide a bearer token for 'Authorization: Bearer {value}' header format."
      }
    }
