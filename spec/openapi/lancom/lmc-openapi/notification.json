        "required" : [ "description", "references", "timeStamps", "title" ],
        "type" : "object",
        "properties" : {
          "references" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/ReferenceFrontend"
            }
          },
          "timeStamps" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string",
              "format" : "date-time"
            }
          },
          "title" : {
            "type" : "string",
            "description" : "Short description (title) of the notification. This could be used for instance as an email header."
          },
          "description" : {
            "type" : "string",
            "description" : "Long description of the notification. Supports templates."
          }
        }
      },
      "PaginationNextChunk" : {
        "required" : [ "mark" ],
        "type" : "object",
        "properties" : {
          "mark" : {
            "type" : "string"
          }
        }
      },
      "ReferenceFrontend" : {
        "required" : [ "id", "name", "type" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "resolved" : {
            "type" : "boolean"
          }
        }
      },
      "StateCounts" : {
        "type" : "object",
        "properties" : {
          "open" : {
            "type" : "integer"
          },
          "closed" : {
            "type" : "integer"
          }
        },
        "description" : "key / value pairs of { state : count } based on the request param."
      },
      "TranslatedAlert" : {
        "required" : [ "createdAt", "id", "logIds", "state", "stateUpdatedAt", "template", "type" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string"
          },
          "state" : {
            "$ref" : "#/components/schemas/AlertState"
          },
          "logIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "stateUpdatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "template" : {
            "$ref" : "#/components/schemas/NotificationTemplate"
          }
        }
      },
      "TranslatedNotification" : {
        "required" : [ "createdAt", "id", "logIds", "state", "stateUpdatedAt", "template", "type" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string"
          },
          "state" : {
            "$ref" : "#/components/schemas/NotificationState"
          },
          "logIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "stateUpdatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "template" : {
            "$ref" : "#/components/schemas/NotificationTemplate"
          }
        }
      }
    },
    "responses" : {
      "HTTP_400" : {
        "description" : "Wrong data",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ErrorResponseBody"
            }
          }
        }
      },
      "HTTP_401" : {
        "description" : "Not authenticated"
