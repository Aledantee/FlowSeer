        }, {
          "name" : "authorityId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      },
      "post" : {
        "operationId" : "accountsAccountIdAuthoritiesAuthorityIdRightsPost",
        "x-lmc-disable-api-key" : true,
        "tags" : [ "Authorization" ],
        "summary" : "Updates rights of the given authority",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "name" : "accountId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "authorityId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        },
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LibSecurityRightList"
              }
            }
          },
          "required" : true
        }
      },
      "delete" : {
        "operationId" : "accountsAccountIdAuthoritiesAuthorityIdRightsDelete",
        "x-lmc-disable-api-key" : true,
        "tags" : [ "Authorization" ],
        "summary" : "Deletes rights of the given authority",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "name" : "accountId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "authorityId",
          "in" : "path",
