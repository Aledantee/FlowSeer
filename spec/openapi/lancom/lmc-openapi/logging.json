  "paths" : {
    "/accounts/{accountId}/authorities/{authorityId}/rights" : {
      "get" : {
        "operationId" : "accountsAccountIdAuthoritiesAuthorityIdRightsGet",
        "tags" : [ "Authorization" ],
        "summary" : "Lists rights of the given authority",
