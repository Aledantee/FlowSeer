    "/rights/public" : {
      "get" : {
        "operationId" : "rightsPublicGet",
        "tags" : [ "Authorization" ],
        "summary" : "Lists all available rights",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        } ],
        "responses" : {
          "200" : {
            "description" : "All available rights",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      }
