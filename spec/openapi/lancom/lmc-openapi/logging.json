          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "name" : "accountId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "authorityId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      },
      "post" : {
        "operationId" : "accountsAccountIdAuthoritiesAuthorityIdRightsPost",
        "x-lmc-disable-api-key" : true,
        "tags" : [ "Authorization" ],
        "summary" : "Updates rights of the given authority",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "name" : "accountId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "authorityId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        },
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LibSecurityRightList"
              }
            }
          },
          "required" : true
        }
      },
      "delete" : {
        "operationId" : "accountsAccountIdAuthoritiesAuthorityIdRightsDelete",
        "x-lmc-disable-api-key" : true,
        "tags" : [ "Authorization" ],
        "summary" : "Deletes rights of the given authority",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "name" : "accountId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "authorityId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Rights have been removed"
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      }
    },
    "/accounts/{accountId}/logs/archives" : {
      "get" : {
        "tags" : [ "Logs" ],
        "summary" : "Get account specific list of log archives.",
        "description" : "<h4>Required rights:</h4> <table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>ARCHIVE_ACCESS</td><td>Right to access archives</td></tr><tbody></table>",
        "operationId" : "getArchives",
        "parameters" : [ {
          "$ref" : "#/components/parameters/AccountId"
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ArchiveDtos"
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/HTTP_400"
          },
          "401" : {
            "$ref" : "#/components/responses/HTTP_401"
          },
          "403" : {
            "$ref" : "#/components/responses/HTTP_403"
          },
          "404" : {
            "$ref" : "#/components/responses/HTTP_404"
          }
        }
      }
    },
    "/accounts/{accountId}/logs/archives/settings" : {
      "get" : {
        "tags" : [ "Logs" ],
        "summary" : "Get account specific log archives settings.",
        "description" : "Returns whether log archive settings enabled for an account. <h4>Required rights:</h4> <table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>ARCHIVE_SETTINGS_READ</td><td>Right to read archive settings</td></tr><tbody></table>",
        "operationId" : "getArchivesSettings",
        "parameters" : [ {
          "$ref" : "#/components/parameters/AccountId"
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ArchiveSettingsDto"
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/HTTP_400"
          },
          "401" : {
            "$ref" : "#/components/responses/HTTP_401"
          },
          "403" : {
            "$ref" : "#/components/responses/HTTP_403"
          },
          "404" : {
            "$ref" : "#/components/responses/HTTP_404"
          }
        }
      },
      "put" : {
        "tags" : [ "Logs" ],
        "summary" : "Put the account specific log archive settings.",
        "description" : "<h4>Required rights:</h4> <table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>ARCHIVE_ACCESS</td><td>Right to update the account specific log archive settings</td></tr><tbody></table>",
        "operationId" : "putArchiveSettings",
        "parameters" : [ {
          "$ref" : "#/components/parameters/AccountId"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ArchiveSettingsDto"
              }
            }
          },
          "required" : false
        },
        "responses" : {
          "200" : {
            "description" : "Archive settings",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ArchiveSettingsDto"
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/HTTP_400"
          },
          "401" : {
            "$ref" : "#/components/responses/HTTP_401"
          },
          "403" : {
            "$ref" : "#/components/responses/HTTP_403"
          },
          "404" : {
            "$ref" : "#/components/responses/HTTP_404"
          }
        }
      }
    },
    "/accounts/{accountId}/logs/archives/{archiveId}" : {
      "get" : {
        "tags" : [ "Logs" ],
        "summary" : "Download log archive by id.",
        "description" : "<h4>Required rights:</h4> <table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>ARCHIVE_ACCESS</td><td>Right to access the log archive</td></tr><tbody></table>",
        "operationId" : "downloadArchiveById",
        "parameters" : [ {
          "$ref" : "#/components/parameters/AccountId"
        }, {
          "$ref" : "#/components/parameters/ArchiveId"
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/zip" : {
                "schema" : {
                  "type" : "string",
                  "format" : "binary"
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/HTTP_400"
          },
          "401" : {
            "$ref" : "#/components/responses/HTTP_401"
          },
          "403" : {
            "$ref" : "#/components/responses/HTTP_403"
          },
          "404" : {
            "$ref" : "#/components/responses/HTTP_404"
          }
        }
      }
    },
    "/rights/accounts" : {
      "get" : {
        "operationId" : "rightsAccountsGet",
        "tags" : [ "Authorization" ],
        "summary" : "Lists current user's rights for the token accounts",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        } ],
        "responses" : {
          "200" : {
            "description" : "Account right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityAccountList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      }
    },
