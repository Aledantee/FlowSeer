  "components" : {
    "schemas" : {
      "ArchiveDto" : {
        "required" : [ "createdAt", "id", "month", "status", "year" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "scheduled", "creating", "created" ]
          },
          "month" : {
            "type" : "integer"
          },
          "year" : {
            "type" : "integer"
          },
          "fileSizeInKiloBytes" : {
            "type" : "integer"
          },
          "logCount" : {
            "type" : "integer"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "ArchiveDtos" : {
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/ArchiveDto"
        }
      },
      "ArchiveSettingsDto" : {
        "type" : "object",
        "properties" : {
          "enabled" : {
            "type" : "boolean"
          }
        }
      },
      "ErrorResponseBody" : {
        "type" : "object",
        "properties" : {
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "service" : {
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer"
          },
          "path" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        }
      },
      "LibSecurityAccount" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "rights" : {
            "$ref" : "#/components/schemas/LibSecurityRightList"
          }
        }
      },
      "LibSecurityAccountList" : {
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/LibSecurityAccount"
        }
      },
      "LibSecurityRightList" : {
        "type" : "array",
        "items" : {
          "type" : "string"
        }
      }
    },
    "responses" : {
      "HTTP_400" : {
        "description" : "Wrong data",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ErrorResponseBody"
            }
          }
        }
      },
      "HTTP_401" : {
        "description" : "Not authenticated"
      },
      "HTTP_403" : {
        "description" : "Forbidden",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ErrorResponseBody"
            }
          }
        }
      },
      "HTTP_404" : {
        "description" : "Not found",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ErrorResponseBody"
            }
          }
        }
      }
    },
    "parameters" : {
      "AccountId" : {
        "name" : "accountId",
        "in" : "path",
        "description" : "The unique identifier(UUID) of the account/project for which the logs are requested.",
        "example" : "946dc887-fe79-4fdd-a52f-a62a467a6520",
        "required" : true,
        "schema" : {
          "type" : "string",
          "format" : "uuid"
        }
      },
      "ArchiveId" : {
        "name" : "archiveId",
        "in" : "path",
        "required" : true,
        "schema" : {
          "type" : "string",
          "format" : "uuid"
        }
      },
      "TOKEN" : {
        "name" : "Authorization",
        "in" : "header",
        "description" : "JWT based Session token",
        "required" : false,
        "schema" : {
          "type" : "string"
        }
      }
    },
    "securitySchemes" : {
      "apiKey" : {
        "type" : "apiKey",
        "in" : "header",
        "name" : "Authorization",
        "description" : "Provide an API key for 'Authorization: LMC-API-KEY {value}' header format."
      },
      "basic" : {
        "type" : "http",
        "scheme" : "basic",
        "description" : "Provide a username and password. Account IDs may be set optionally."
      },
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT",
        "description" : "Provide a bearer token for 'Authorization: Bearer {value}' header format."
      }
    }
  }
}
