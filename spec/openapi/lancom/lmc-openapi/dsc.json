{
  "openapi" : "3.0.3",
  "info" : {
    "title" : "DSC API Documentation",
    "version" : "0.0.1000",
    "description" : "This is the API documentation of the DSC LMC service.",
    "contact" : {
      "name" : "Paul Smith",
      "email" : "paul.smith@lancom.de"
    }
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearer" : [ ]
  }, {
    "apiKey" : [ ]
  }, {
    "basic" : [ ]
  } ],
  "paths" : {
    "/accounts/{accountId}/authorities/{authorityId}/rights" : {
      "get" : {
        "operationId" : "accountsAccountIdAuthoritiesAuthorityIdRightsGet",
        "tags" : [ "Authorization" ],
        "summary" : "Lists rights of the given authority",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "name" : "accountId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "authorityId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      },
      "post" : {
        "operationId" : "accountsAccountIdAuthoritiesAuthorityIdRightsPost",
        "x-lmc-disable-api-key" : true,
        "tags" : [ "Authorization" ],
        "summary" : "Updates rights of the given authority",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "name" : "accountId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "authorityId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        },
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LibSecurityRightList"
              }
            }
          },
          "required" : true
        }
      },
      "delete" : {
        "operationId" : "accountsAccountIdAuthoritiesAuthorityIdRightsDelete",
        "x-lmc-disable-api-key" : true,
        "tags" : [ "Authorization" ],
        "summary" : "Deletes rights of the given authority",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "name" : "accountId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "authorityId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Rights have been removed"
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      }
    },
    "/dsc/{filename}" : {
      "get" : {
        "summary" : "Get a DSC",
        "description" : "Get a specific DS file identified by filename.",
        "parameters" : [ {
          "name" : "filename",
          "in" : "path",
          "description" : "The name of the file.",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The returned setting",
            "content" : {
              "text/plain; charset=ISO-8859-1" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "403" : {
            "description" : "Authentication Error",
            "content" : { }
          }
        }
      }
    },
    "/metadata" : {
      "get" : {
        "summary" : "Get all DSC info entries",
        "description" : "Returns all available DSC info entries.",
        "responses" : {
          "200" : {
            "description" : "The list of (key,value) pairs",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/DscMetadata"
                  }
                }
              }
            }
          },
          "403" : {
            "description" : "Authentication Error",
            "content" : { }
          }
        }
      }
    },
    "/rights/accounts" : {
      "get" : {
        "operationId" : "rightsAccountsGet",
        "tags" : [ "Authorization" ],
        "summary" : "Lists current user's rights for the token accounts",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        } ],
        "responses" : {
          "200" : {
            "description" : "Account right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityAccountList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      }
    },
    "/rights/accounts/{accountId}" : {
      "get" : {
        "operationId" : "rightsAccountsAccountIdGet",
        "tags" : [ "Authorization" ],
        "summary" : "Lists current user's rights for the given account",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "name" : "accountId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      }
    },
    "/rights/public" : {
      "get" : {
        "operationId" : "rightsPublicGet",
        "tags" : [ "Authorization" ],
        "summary" : "Lists all available rights",
        "parameters" : [ {
          "$ref" : "#/components/parameters/TOKEN"
        } ],
        "responses" : {
          "200" : {
            "description" : "All available rights",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "DscMetadata" : {
        "type" : "object",
        "properties" : {
          "filename" : {
            "type" : "string"
          },
          "md5" : {
            "type" : "string"
          },
          "fileLastChanged" : {
            "type" : "integer"
          },
          "length" : {
            "type" : "integer"
          }
        }
      },
      "LibSecurityAccount" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "rights" : {
            "$ref" : "#/components/schemas/LibSecurityRightList"
          }
        }
      },
      "LibSecurityAccountList" : {
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/LibSecurityAccount"
        }
      },
      "LibSecurityRightList" : {
        "type" : "array",
        "items" : {
          "type" : "string"
        }
      }
    },
    "parameters" : {
      "TOKEN" : {
        "name" : "Authorization",
        "in" : "header",
        "description" : "JWT based Session token",
        "required" : false,
        "schema" : {
          "type" : "string"
        }
      }
    },
    "securitySchemes" : {
      "apiKey" : {
        "type" : "apiKey",
        "in" : "header",
        "name" : "Authorization",
        "description" : "Provide an API key for 'Authorization: LMC-API-KEY {value}' header format."
      },
      "basic" : {
        "type" : "http",
        "scheme" : "basic",
        "description" : "Provide a username and password. Account IDs may be set optionally."
      },
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT",
        "description" : "Provide a bearer token for 'Authorization: Bearer {value}' header format."
      }
    }
  }
}
