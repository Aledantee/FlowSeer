          }
        }
      },
      "put" : {
        "tags" : [ "Claim Devices Job" ],
        "operationId" : "changeClaimDevicesState",
        "summary" : "Stop/Continue a job.",
        "description" : "Requests a job state change. The request is only permitted for the delegator user. Returns a 400 error status if the current job state does not support the operation. Continue is supported in state VALIDATION_STOPPED and IMPORT_STOPPED.<h4>Required rights:</h4> <table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>JOB_MODIFY</td><td>Right for creating and modifying jobs.</td></tr><tbody></table>",
        "parameters" : [ {
          "$ref" : "#/components/parameters/ACCOUNT_ID"
        }, {
          "$ref" : "#/components/parameters/JobId"
        }, {
          "$ref" : "#/components/parameters/ChangeJobState"
        } ],
        "requestBody" : {
          "description" : "Empty JSON object (optional)",
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "object",
                "properties" : { }
              }
            }
          },
          "required" : false
        },
        "responses" : {
          "200" : {
            "description" : "Job details and state.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportJobData"
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/HTTP_400"
          },
          "401" : {
            "$ref" : "#/components/responses/HTTP_401"
          },
          "403" : {
            "description" : "<p>A code property value may indicate the error.</p><table><thead><tr><th>Code</th><th>Description</th></tr></thead><tbody><tr><td>1</td><td>Current principal user is not delegator of this job.</td></tr><tbody></table>",
            "content" : { }
          }
        }
      },
      "delete" : {
        "tags" : [ "Claim Devices Job" ],
        "operationId" : "deleteClaimDevicesJob",
        "summary" : "Deletes the job.",
        "description" : "Deletes the job. Returns an error if the current job state does not support the operation. Delete succeeds in states CREATED, UPLOAD_ABORTED, UPLOADED, VALIDATION_STOPPED, VALIDATED_ERRORS, VALIDATED, IMPORT_STOPPED, IMPORTED_ERRORS, IMPORTED.<h4>Required rights:</h4> <table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>JOB_MODIFY</td><td>Right for creating and modifying jobs.</td></tr><tbody></table>",
