          "$ref" : "#/components/parameters/TOKEN"
        }, {
          "$ref" : "#/components/parameters/ACCOUNT_ID"
        } ],
        "requestBody" : {
          "description" : "Empty JSON object (optional)",
          "content" : {
            "application/json" : {
