  "components" : {
    "schemas" : {
      "ErrorResponseBody" : {
        "type" : "object",
        "properties" : {
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "service" : {
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer"
          },
          "path" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        }
      },
      "LibSecurityAccount" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "rights" : {
            "$ref" : "#/components/schemas/LibSecurityRightList"
          }
        }
      },
      "LibSecurityAccountList" : {
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/LibSecurityAccount"
        }
      },
      "LibSecurityRightList" : {
        "type" : "array",
        "items" : {
          "type" : "string"
        }
      },
      "TunnelCreateData" : {
        "type" : "object",
        "required" : [ "type", "deviceIds" ],
        "properties" : {
          "type" : {
            "type" : "string",
            "enum" : [ "WEBCONFIG", "TERMINAL", "UNDEFINED" ]
          },
          "deviceIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          }
        }
      },
      "TunnelGetData" : {
        "type" : "object",
        "required" : [ "deviceId", "type", "entryToken" ],
        "properties" : {
          "deviceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "TERMINAL", "WEBCONFIG", "UNDEFINED" ]
          },
          "entryToken" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "WebConfigTunnelStatusData" : {
        "type" : "object",
        "required" : [ "deviceStatus", "userStatus" ],
        "properties" : {
          "deviceStatus" : {
            "type" : "string",
            "enum" : [ "DISCONNECTED", "CONNECTED" ]
          }
        }
      }
    },
    "responses" : {
      "HTTP_400" : {
        "description" : "Wrong data",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ErrorResponseBody"
            }
          }
        }
      },
      "HTTP_401" : {
        "description" : "Not authenticated"
      }
    },
    "parameters" : {
      "TOKEN" : {
        "name" : "Authorization",
        "in" : "header",
        "description" : "JWT based Session token",
        "required" : false,
        "schema" : {
          "type" : "string"
        }
      }
    },
    "securitySchemes" : {
      "apiKey" : {
        "type" : "apiKey",
        "in" : "header",
        "name" : "Authorization",
        "description" : "Provide an API key for 'Authorization: LMC-API-KEY {value}' header format."
      },
      "basic" : {
        "type" : "http",
        "scheme" : "basic",
        "description" : "Provide a username and password. Account IDs may be set optionally."
      },
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT",
        "description" : "Provide a bearer token for 'Authorization: Bearer {value}' header format."
      }
    }
  }
}
