        "responses" : {
          "200" : {
            "description" : "Right list",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LibSecurityRightList"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized"
          }
        },
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LibSecurityRightList"
              }
            }
          },
          "required" : true
