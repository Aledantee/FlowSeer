          }
        }
      }
    },
    "/accounts/{accountId}/webconfig/{entryToken}" : {
      "get" : {
        "tags" : [ "Webconfig" ],
        "description" : "<p>Get status of WEBconfig session.<br>This endpoint will return session not found after the entry token is used in the first request to the device.</p><h4>Required rights</h4><table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>SESSION_WEBCONFIG_CREATE</td><td>Right to create Webconfig-Session</td></tr><tbody></table>",
        "summary" : "Device connection status of WEBconfig tunnel",
        "parameters" : [ {
          "name" : "accountId",
          "in" : "path",
          "description" : "The account id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "entryToken",
          "in" : "path",
          "description" : "Entry token of the tunnel session",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Session found and returned",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WebConfigTunnelStatusData"
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/HTTP_400"
          },
          "401" : {
            "$ref" : "#/components/responses/HTTP_401"
          },
          "403" : {
            "description" : "Caller is not allowed to get a webconfig session status."
          }
        }
      }
    },
