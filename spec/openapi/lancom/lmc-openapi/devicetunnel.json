      "delete" : {
        "operationId" : "accountsAccountIdAuthoritiesAuthorityIdRightsDelete",
        "x-lmc-disable-api-key" : true,
        "tags" : [ "Authorization" ],
        "summary" : "Deletes rights of the given authority",
        "parameters" : [ {
