      "delete" : {
        "tags" : [ "Webconfig" ],
        "description" : "<p>Delete webconfig sessions</p><h4>Required rights</h4><table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>SESSION_WEBCONFIG_DELETE</td><td>Right to delete Webconfig-Session</td></tr><tbody></table>",
        "summary" : "Delete webconfig sessions",
