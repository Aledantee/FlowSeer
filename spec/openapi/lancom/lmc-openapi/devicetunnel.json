          "200" : {
            "description" : "Rights have been removed"
          },
          "401" : {
            "description" : "Unauthorized"
          }
        }
      }
    },
    "/accounts/{accountId}/terminal" : {
      "post" : {
        "tags" : [ "Terminal" ],
        "description" : "<p>Create terminal session</p><h4>Required rights</h4><table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>SESSION_TERMINAL_CREATE</td><td>Right to create Terminal-Session</td></tr><tbody></table>",
        "summary" : "Create terminal session",
        "parameters" : [ {
          "name" : "accountId",
          "in" : "path",
          "description" : "The account id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TunnelCreateData"
              }
            }
          },
          "required" : false
        },
        "responses" : {
          "200" : {
            "description" : "Tunnel terminal session was created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TunnelGetData"
                  }
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/HTTP_400"
          },
          "401" : {
            "$ref" : "#/components/responses/HTTP_401"
          },
          "403" : {
            "description" : "Caller is not allowed to create a termial session."
          }
        }
      },
      "delete" : {
        "tags" : [ "Terminal" ],
        "description" : "<p>Delete terminal session</p><h4>Required rights</h4><table><thead><tr><th>Right</th><th>Description</th></tr></thead><tbody><tr><td>SESSION_TERMINAL_DELETE</td><td>Right to delete Terminal-Session</td></tr><tbody></table>",
        "summary" : "Delete terminal sessions",
        "parameters" : [ {
          "name" : "accountId",
          "in" : "path",
          "description" : "The account id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "description" : "To be deleted tunnel ids",
          "in" : "query",
          "name" : "ids",
          "required" : true,
          "schema" : {
            "maxItems" : 50,
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Terminal sessions have been deleted"
          },
          "400" : {
            "$ref" : "#/components/responses/HTTP_400"
          },
          "401" : {
            "$ref" : "#/components/responses/HTTP_401"
          },
          "403" : {
            "description" : "Caller is not allowed to delete terminal sessions"
          }
        }
      }
    },
