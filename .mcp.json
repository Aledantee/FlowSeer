{
  "mcpServers": {
    "agentation": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "--silent",
        "--dir",
        "frontend/web",
        "exec",
        "agentation-mcp",
        "server"
      ],
      "env": {
        "AGENTATION_STORE": "memory"
      }
    }
  }
}
