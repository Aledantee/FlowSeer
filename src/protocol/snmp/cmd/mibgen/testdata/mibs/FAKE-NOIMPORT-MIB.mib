FAKE-NOIMPORT-MIB DEFINITIONS ::= BEGIN
IMPORTS
    OBJECT-TYPE, MODULE-IDENTITY
        FROM SNMPv2-SMI
    DisplayString
        FROM SNMPv2-TC;

-- FakeKeyIndex is used below without being imported from FAKE-KEYS-MIB.
-- The resolver still finds it once that module is loaded; the generator
-- must not, so both the key field and the column render without it.

fakeNoImportMIB MODULE-IDENTITY
    LAST-UPDATED "202609050000Z"
    ORGANIZATION "FlowSeer Test"
    CONTACT-INFO "test"
    DESCRIPTION  "Uses a keyed convention it never imports."
    ::= { 1 3 6 1 4 1 99999 3 }

fakeNoImportTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF FakeNoImportEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "A table keyed and referenced by an unimported convention."
    ::= { fakeNoImportMIB 1 }

fakeNoImportEntry OBJECT-TYPE
    SYNTAX      FakeNoImportEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "A row in fakeNoImportTable."
    INDEX { fakeNoImportIndex }
    ::= { fakeNoImportTable 1 }

FakeNoImportEntry ::= SEQUENCE {
    fakeNoImportIndex   FakeKeyIndex,
    fakeNoImportName    DisplayString,
    fakeNoImportRef     FakeKeyIndex
}

fakeNoImportIndex OBJECT-TYPE
    SYNTAX      FakeKeyIndex
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "Row index typed by the unimported convention."
    ::= { fakeNoImportEntry 1 }

fakeNoImportName OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Name."
    ::= { fakeNoImportEntry 2 }

fakeNoImportRef OBJECT-TYPE
    SYNTAX      FakeKeyIndex
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "A reference typed by the unimported convention."
    ::= { fakeNoImportEntry 3 }

END
