# scapy 2.7 renamed DHCP options: 53 "mtype" -> "mtype",
# 6 "domain_name_server" -> "name_server". Derive the installed scapy's
# builder name from the numeric option code so frames are well-formed on
# either generation.
def _dhcp_opt_name(code, fallback):
    """Installed scapy's registered name for DHCP option `code`."""
    try:
        from scapy.layers.dhcp import DHCPOptions
        v = DHCPOptions.get(code)
        if isinstance(v, str):
            return v
        name = getattr(v, "name", None)
        if isinstance(name, str):
            return name
    except Exception:
        pass
    return fallback


DHCP_MT = _dhcp_opt_name(53, "mtype")
DHCP_DNS = _dhcp_opt_name(6, "domain_name_server")


# ---------------------------------------------------------------- helpers


def die(msg):
    print(f"[!] {msg}", file=sys.stderr)
    sys.exit(1)


def need_root():
    if os.geteuid() != 0:
        die("must run as root: sudo l2l3-audit <cmd>")


def rand_mac():
    return "02:%02x:%02x:%02x:%02x:%02x" % tuple(random.randint(0, 255)
                                                 for _ in range(5))


def parent_of(iface):
    """eth0.1000 -> eth0 ; eth0 -> eth0"""
    return iface.split(".")[0]


def vlan_of(iface):
    m = re.search(r"\.(\d+)$", iface)
    return int(m.group(1)) if m else None


def vlan_up(parent, vid):
    """Create + raise an 802.1Q subinterface parent.vid. Returns name."""
    sub = f"{parent}.{vid}"
    if os.path.isdir(f"/sys/class/net/{sub}"):
        return sub
    r = subprocess.run(["ip", "link", "add", "link", parent, "name", sub,
                        "type", "vlan", "id", str(vid)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"failed to create {sub}: {r.stderr.strip()}")
    subprocess.run(["ip", "link", "set", sub, "up"], capture_output=True)
    return sub


def vlan_down(subif):
    if os.path.isdir(f"/sys/class/net/{subif}"):
        subprocess.run(["ip", "link", "del", subif], capture_output=True)


def iface_exists(name):
    """True when the kernel knows an interface by this name."""
    return bool(name) and os.path.isdir(f"/sys/class/net/{name}")


