                       999, 1000, 1234, 2000, 3000, 4000, 4094)


def dhcp_discover_addr(subif, timeout=15):
    """Get an IPv4 address on subif via DHCP. Returns (ip, server) or
    (None, None). Sniffs the wire ourselves; no dhclient dependency."""
    mymac = my_mac(subif)
    chaddr = int(mymac.replace(":", ""), 16).to_bytes(6, "big") + b"\x00" * 10
    res = {"ip": None, "server": None}
    xid = random.randint(0, 0xFFFFFFFF)

    def hit(p):
        if not (p.haslayer(BOOTP) and p.haslayer(DHCP)):
            return
        if p[BOOTP].xid != xid or p[BOOTP].op != 2:
            return
        mt = next((o[1] for o in p[DHCP].options
                   if isinstance(o, tuple) and o[0] == DHCP_MT), None)
        if mt == 2:  # OFFER -> REQUEST
            res["ip"] = p[BOOTP].yiaddr
            res["server"] = next((o[1] for o in p[DHCP].options
                                  if isinstance(o, tuple)
                                  and o[0] == "server_id"), p[IP].src)
            req = (Ether(src=mymac, dst="ff:ff:ff:ff:ff:ff") /
                   IP(src="0.0.0.0", dst="255.255.255.255") /
                   UDP(sport=68, dport=67) /
                   BOOTP(chaddr=chaddr, xid=xid) /
                   DHCP(options=[(DHCP_MT, "request"),
                                 ("requested_addr", res["ip"]),
                                 ("server_id", res["server"]), "end"]))
            sendp(req, iface=subif, verbose=0)
        elif mt == 5 and res["ip"]:  # ACK
            res["acked"] = True

    sniffer = AsyncSniffer(iface=subif,
                           filter="udp port 68 or udp port 67",
                           prn=hit)
    sniffer.start()
    time.sleep(0.3)
    disc = (Ether(src=mymac, dst="ff:ff:ff:ff:ff:ff") /
            IP(src="0.0.0.0", dst="255.255.255.255") /
            UDP(sport=68, dport=67) /
            BOOTP(chaddr=chaddr, xid=xid) /
            DHCP(options=[(DHCP_MT, "discover"),
                          ("param_req_list",
                           [1, 3, 6, 51, 54, 121]), "end"]))
    sendp(disc, iface=subif, verbose=0)
    t0 = time.time()
    while time.time() - t0 < timeout and not res.get("acked"):
        time.sleep(0.2)
    sniffer.stop()
    if res.get("acked") and res["ip"]:
        mask = "24"
        subprocess.run(["ip", "addr", "add",
                        f"{res['ip']}/{mask}", "dev", subif],
                       capture_output=True)
        return res["ip"], res["server"]
    return None, None


def net_of(iface):
    """IPv4 CIDR configured on iface, for sweep defaults."""
    out = subprocess.run(["ip", "-4", "-o", "addr", "show", "dev", iface],
                         capture_output=True, text=True).stdout
    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)/(\d+)", out)
    if not m:
        return None
    return str(ipaddress.ip_network(f"{m.group(1)}/{m.group(2)}",
                                    strict=False))


def my_mac(iface):
    return get_if_hwaddr(iface)


def my_ip(iface):
    try:
        return get_if_addr(iface)
    except Exception:
        return "0.0.0.0"


def set_ip_forward(on):
    with open("/proc/sys/net/ipv4/ip_forward", "w") as f:
        f.write("1" if on else "0")


def get_ip_forward():
    with open("/proc/sys/net/ipv4/ip_forward") as f:
        return f.read().strip() == "1"


def resolve_mac(ip, iface, retries=4, timeout=2):
    for _ in range(retries):
        ans, _ = srp(Ether(dst="ff:ff:ff:ff:ff:ff") / ARP(pdst=ip),
                     iface=iface, timeout=timeout, verbose=0)
        if ans:
            return ans[0][1].hwsrc
    return None


def my_ll6(iface):
    """Link-local IPv6 of iface; synthesize EUI-64 if missing."""
    out = subprocess.run(["ip", "-6", "addr", "show", "dev", iface,
                          "scope", "link"], capture_output=True,
                         text=True).stdout
    m = re.search(r"inet6 (fe80::[0-9a-f:]+)", out)
    if m:
        return m.group(1)
    return ll6_from_mac(my_mac(iface))


def ll6_from_mac(mac):
    b = [int(x, 16) for x in mac.split(":")]
    b[0] ^= 0x02
    return "fe80::%02x%02x:%02xff:fe%02x:%02x%02x" % tuple(b)


def gateway_of(iface):
    out = subprocess.run(["ip", "route", "show", "default"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        m = re.search(r"default via (\S+) dev (\S+)", line)
        if m and (m.group(2) == iface or parent_of(m.group(2)) == parent_of(iface)):
            return m.group(1)
    m = re.search(r"default via (\S+)", out)
    return m.group(1) if m else None


def stop_loop(body):
    """Run body(stop_flag: callable) until Ctrl-C."""
    stop = {"flag": False}

    def _sig(sig, frm):
        stop["flag"] = True
    signal.signal(signal.SIGINT, _sig)
    body(lambda: stop["flag"])

# ---------------------------------------------------------------- scan


def parse_tlvs(payload):
    """Generic Cisco-style TLV walker: type(2) len(2) value"""
    out = []
    i = 0
    while i + 4 <= len(payload):
        t, l = struct.unpack("!HH", payload[i:i + 4])
        if l < 4 or i + l > len(payload):
            break
        out.append((t, payload[i + 4:i + l]))
        i += l
    return out


def scan_cmd(args):
    need_root()
    if not iface_exists(args.iface):
        die(f"interface {args.iface} does not exist")
    pif = parent_of(args.iface)
    watch = getattr(args, "watch", None)
    legs = [args.iface]
    if watch:
        if iface_exists(watch):
            legs.append(watch)
        else:
            print(f"[!] watch interface {watch} not present - continuing "
                  "single-leg on the attack interface")
    # sniff parents only: a parent sees every tagged frame its
    # subinterfaces see, so adding children would double-count.
    ifaces = sorted({parent_of(i) for i in legs})
    seen = {"stp": [], "cdp": {}, "dtp": 0, "vtp": set(), "lldp": 0,
            "hsrp": {}, "vrrp": {}, "dhcp_srv": set(),
            "arp": {}, "conflicts": set(), "hosts": set(), "vlans": set(),
            "ospf": 0, "ospf_auth": {}, "eigrp": 0, "mvrp": 0,
            "macsec": 0, "bad_rdnss": set(), "frag_nd": 0, "ra6": 0,
            "vtp_rev": None}

    announced = set()

    def announce(tag, msg):
        """One-shot intermediate status when a protocol is first seen."""
        if tag not in announced:
            announced.add(tag)
            console.print(f"    [cyan]+[/cyan] {msg}")

    def ctl(dp):
        """Control-plane protocols parsed as 802.3/LLC."""
        if dp.haslayer(STP):
            s = dp[STP]
            seen["stp"].append((s.rootmac, s.rootid, s.bridgemac))
            announce("stp", f"STP BPDU: root {s.rootmac}")
            return
        if dp.haslayer(SNAP):
            sn = dp[SNAP]
            oui = getattr(sn, "OUI", 0)
            body = bytes(sn.payload)
            if oui == 0x00000C and sn.code == 0x2000:  # CDP
                announce("cdp", "CDP disclosure frames")
                hdr = body[:4]  # version, ttl, cksum
                for t, v in parse_tlvs(body[4:]):
                    if t == 0x0001:
                        seen["cdp"]["device"] = v.decode(errors="replace")
                    elif t == 0x0003:
                        seen["cdp"]["port"] = v.decode(errors="replace")
                    elif t == 0x0005:
                        seen["cdp"]["ios"] = v.decode(errors="replace"
                                                      ).splitlines()[0][:80]
                    elif t == 0x0006:
                        seen["cdp"]["platform"] = v.decode(errors="replace")
                    elif t == 0x000A and len(v) >= 2:
                        seen["cdp"]["native_vlan"] = struct.unpack("!H", v[:2])[0]
                    elif t == 0x000E and len(v) >= 3:
                        seen["cdp"]["voice_vlan"] = struct.unpack("!H",
                                                                  v[-2:])[0]
            elif oui == 0x00000C and sn.code == 0x2004:  # DTP
                seen["dtp"] += 1
                announce("dtp", "DTP trunk-negotiation frames")
            elif oui == 0x00000C and sn.code == 0x2003:  # VTP
                if len(body) > 5:
                    dlen = body[3]
                    if 0 < dlen <= 32 and 4 + dlen <= len(body):
                        dom = body[4:4 + dlen].decode(errors="replace"
                                                      ).strip("\x00")
                        if dom:
                            seen["vtp"].add(dom)
                            announce(f"vtp-{dom}", f"VTP domain '{dom}'")
                if len(body) >= 40 and body[1] == 0x01:  # summary advert
                    seen["vtp_rev"] = struct.unpack("!I", body[36:40])[0]

    def pkt(p):
        try:
            dp = Dot3(bytes(p))
        except Exception:
            dp = p
        ctl(dp)
        # --- Ether-typed protocols
        if p.haslayer(Ether) and p[Ether].type == 0x88CC:
            seen["lldp"] += 1
            announce("lldp", "LLDP topology disclosure")
        if HAVE_HSRP and p.haslayer(HSRP):
            h = p[HSRP]
            seen["hsrp"][h.group] = (h.priority, h.virtualIP, h.state)
            announce(f"hsrp-{h.group}",
                     f"HSRP group {h.group} vip {h.virtualIP}")
        if p.haslayer(IP):
            if p[IP].proto == 89 and p[IP].dst in ("224.0.0.5", "224.0.0.6"):
                seen["ospf"] += 1
                announce("ospf", f"OSPF routing traffic from {p[IP].src}")
                raw = bytes(p[IP].payload)
                if len(raw) >= 18:
                    autype = struct.unpack("!H", raw[16:18])[0]
                    seen["ospf_auth"].setdefault(
                        {0: "null", 1: "cleartext"}.get(autype, f"type{autype}"),
                        p[IP].src)
            elif p[IP].proto == 88 and p[IP].dst == "224.0.0.10":
                seen["eigrp"] += 1
                announce("eigrp", "EIGRP routing traffic")
            if p[IP].proto == 112 and p[IP].dst == "224.0.0.18":
                if HAVE_VRRP and p.haslayer(VRRP):
                    v = p[VRRP]
                    vips = [str(a) for a in v.addrlist] if v.addrlist else []
                    seen["vrrp"][v.vrid] = (v.priority, p[IP].src, vips)
                    announce(f"vrrp-{v.vrid}",
                             f"VRRP vrid {v.vrid} master {p[IP].src}")
                else:
                    seen["vrrp"][None] = (None, p[IP].src, [])
            if p.haslayer(DHCP):
                for opt in p[DHCP].options:
                    if isinstance(opt, tuple) and opt[0] == DHCP_MT \
                            and opt[1] == 2:
                        seen["dhcp_srv"].add(p[IP].src)
                        announce(f"dhcp-{p[IP].src}",
                                 f"DHCP server offering from {p[IP].src}")
        if p.haslayer(ARP):
            a = p[ARP]
            if a.op == 2:
                seen["hosts"].add((a.psrc, a.hwsrc))
                announce("arp", f"first host: {a.psrc} is-at {a.hwsrc}")
                if a.psrc in seen["arp"] and seen["arp"][a.psrc] != a.hwsrc:
                    seen["conflicts"].add((a.psrc, seen["arp"][a.psrc],
                                           a.hwsrc))
                seen["arp"][a.psrc] = a.hwsrc
        # --- 802.1Q/QinQ tags leaking onto this leg (stacked tags walked)
        lay = p
        while lay is not None and lay.name != "NoPayload":
            if lay.name in ("Dot1Q", "Dot1AD") and hasattr(lay, "vlan"):
                seen["vlans"].add(lay.vlan)
                announce(f"vlan-{lay.vlan}",
                         f"802.1Q tag VLAN {lay.vlan} on the wire")
            lay = lay.payload
        # --- MVRP / MACsec presence (data-plane protection posture)
        if p.haslayer(Ether):
            if p[Ether].type == 0x88F5:
                seen["mvrp"] += 1
                announce("mvrp", "MVRP/GVRP dynamic-VLAN traffic")
            elif p[Ether].type == 0x88E5:
                seen["macsec"] += 1
                announce("macsec", "MACsec-secured frames (802.1AE)")
        # --- CVE-class ND anomalies (Bad Neighbor 16898 / 24086 / 38063):
        # even-length RDNSS, option-length overrun, fragmented ND
        if p.haslayer(ICMPv6ND_RA):
            seen["ra6"] += 1
            announce("ra6", f"IPv6 Router Advertisement from "
                            f"{p[IPv6].src if p.haslayer(IPv6) else '?'}")
            opts = bytes(p[ICMPv6ND_RA].payload)
            off = 0
            while off + 2 <= len(opts):
                t = opts[off]
                ln = opts[off + 1]
                if ln == 0 or off + ln * 8 > len(opts):
                    seen["bad_rdnss"].add(
                        f"opt-len overrun type={t} from "
                        f"{p[IPv6].src if p.haslayer(IPv6) else '?'}")
                    break
                if t == 0x19 and ln % 2 == 0:
                    src6 = p[IPv6].src if p.haslayer(IPv6) else "?"
                    seen["bad_rdnss"].add(
                        f"EVEN RDNSS length ({ln}) from {src6} - "
                        "CVE-2020-16898-style option confusion probe")
                off += ln * 8
        if p.haslayer(IPv6) and p[IPv6].nh == 44:
            seen["frag_nd"] += 1
            announce("fragnd", "fragmented ND frame (RFC 6980 drop)")

    print(f"[*] passively listening {args.time}s on: {', '.join(ifaces)}")
    sniff(iface=ifaces, timeout=args.time, store=False, prn=pkt)

    # -------- active VLAN probing --------
    # The port never gets the benefit of the doubt. Whether the vantage
    # is untagged or already tagged on VLAN x, every candidate VLAN is
    # asked by name from the physical parent: only a correctly bounded
    # access port drops all of it; an open trunk / hybrid port / missing
    # pruning answers back. Classic VLAN-hopping research (switch
    # spoofing / double tagging, frogger & VoIP-hopper leak harvesting)
    # hinges on exactly the misconfigs this probes for.
    probe = None
    if not getattr(args, "no_probe", False):
        spec = getattr(args, "probe_vlans", None)
        window = getattr(args, "probe_time", 6)
        cands = parse_vlan_list(spec) if spec else sorted(
            set(DEFAULT_VLAN_PROBES) | set(seen["vlans"])
            | {v for v in (seen["cdp"].get("native_vlan"),
                           seen["cdp"].get("voice_vlan")) if v})
        print(f"[*] active: probing {len(cands)} candidate VLAN(s) from "
              f"{pif} ({window}s window; tagged DHCP+RS per VID, "
              "one untagged native Discover)")
        probe = active_vlan_probe(pif, cands, window)

    print("\n================ L2/L3 FINDINGS ================")

    def hi(m):
        print(f"  [HIGH] {m}")

    def med(m):
        print(f"  [MED ] {m}")

    def info(m):
        print(f"  [INFO] {m}")

    any_find = False
    if seen["stp"]:
        any_find = True
        roots = {str(r[0]) for r in seen["stp"]}
        hi(f"STP BPDUs visible ({len(seen['stp'])}). Root MAC(s): "
           f"{', '.join(roots)}. Root takeover feasible w/o Root/BPDU Guard "
           f"-> stproot")
    if seen["dtp"]:
        any_find = True
        hi(f"DTP frames seen ({seen['dtp']}). Trunk negotiation open -> VLAN "
           f"hopping -> dtp, doubletag")
    if seen["cdp"]:
        any_find = True
        med(f"CDP disclosure: {seen['cdp']}")
    if seen["vtp"]:
        any_find = True
        med(f"VTP domain(s): {', '.join(sorted(seen['vtp']))} - VTP injection "
            f"can wipe the VLAN db (yersinia VTP attack)")
    if seen["lldp"]:
        any_find = True
        med(f"LLDP frames seen ({seen['lldp']}) - topology disclosure")
    if seen["hsrp"]:
        any_find = True
        for g, (prio, vip, state) in seen["hsrp"].items():
            hi(f"HSRP group {g}: prio={prio} vip={vip} state={state} -> "
               f"takeover: hsrp --vip {vip} --group {g}")
    if seen["vrrp"]:
        any_find = True
        for vrid, (prio, src, vips) in seen["vrrp"].items():
            hi(f"VRRP vrid {vrid}: master {src} prio {prio} vip(s) "
               f"{', '.join(vips) or '?'} -> takeover: "
               f"vrrp --vrid {vrid} --vip {' '.join(vips) or '<ip>'}")
    if seen["dhcp_srv"]:
        any_find = True
        info(f"DHCP server(s): {', '.join(sorted(seen['dhcp_srv']))}. "
             f"-> dhcpstarve | roguedhcp")
    if seen["vlans"]:
        any_find = True
        hi(f"802.1Q tags observed on wire: VLAN(s) "
           f"{', '.join(str(v) for v in sorted(seen['vlans']))} reachable "
           f"from this port -> vlanhop --vlan <id>")
    if probe is not None:
        stats, native = probe
        myvlan = vlan_of(args.iface)
        where = ("untagged port" if myvlan is None
                 else f"port tagged VLAN {myvlan} on our side")
        proven = [(v, s) for v, s in stats.items() if s["offer"]]
        weaker = [(v, s) for v, s in stats.items()
                  if not s["offer"] and (s["frames"] or s["ra"])]
        for v, s in sorted(proven):
            any_find = True
            if v == myvlan:
                info(f"active probe: VLAN {v} DHCP answered on the "
                     "assigned tag - placement confirmed (not an "
                     "overflow)")
            else:
                hi(f"active probe: VLAN {v} REACHABLE from this "
                   f"{where} - tagged DHCP Discover answered by "
                   f"{s['offer']}: port carries an unplanned broadcast "
                   "domain (open trunk / hybrid / pruning absent - "
                   f"misconfig) -> vlanhop --vlan {v}")
        for v, s in sorted(weaker):
            any_find = True
            srcs = (f" from {', '.join(sorted(s['srcs']))}"
                    if s["srcs"] else "")
            med(f"active probe: VLAN {v} leaking onto this {where} - "
                f"{s['frames']} tagged frame(s) + {s['ra']} RA(s){srcs} "
                "in the window; bidirectional reachability unproven "
                f"-> retry: vlanhop --vlan {v} --static ...")
        if native is not None and native["offer"]:
            any_find = True
            med(f"active probe: untagged/native VLAN answered DHCP "
                f"({native['offer']})"
                + (" although operating on a tagged subinterface - the "
                   "parent still passes untagged frames (hybrid port)"
                   if myvlan is not None else ""))
        if not proven and not weaker and \
                not (native and native["offer"]):
            info("active probe: no candidate VLAN answered - port "
                 "behaves as a correctly bounded access port (or no "
                 "DHCP/routers there; widen with --probe-vlans)")
    if seen["cdp"].get("voice_vlan"):
        any_find = True
        hi(f"voice VLAN (VVID {seen['cdp']['voice_vlan']}) leaked via CDP "
           "appliance TLV; voice ports are trusted-for-phones and rarely "
           "802.1Xed -> voicevlan")
    if seen["ospf"]:
        any_find = True
        med(f"OSPF visible ({seen['ospf']} msgs); auth= "
            + ", ".join(f"{k} from {v}" for k, v in seen['ospf_auth'].items()
                        ) or "unknown; null/cleartext = LSA injection "
            "surface (Nakibly/NDSS12; fight-back-resistant false self-LSA)")
    if seen["eigrp"]:
        any_find = True
        med(f"EIGRP visible ({seen['eigrp']} msgs); if no MD5 auth TLV: "
            "route/neighbour injection surface (FRR/scapy-contrib)")
    if seen["mvrp"]:
        any_find = True
        hi(f"MVRP/GVRP active ({seen['mvrp']} frames) - dynamic VLAN "
           "registration open -> mvrp --join (no public tool exists)")
    if seen["macsec"]:
        info(f"MACsec deployed ({seen['macsec']} frames 0x88E5) - check "
             "fail-open policy: plain frames accepted? (802.1AE posture)")
    for w in sorted(seen["bad_rdnss"]):
        any_find = True
        hi(f"malformed ICMPv6 RA option stream: {w} "
           "(Bad-Neighbor/24086/38063 class)")
    if seen["frag_nd"]:
        any_find = True
        hi(f"{seen['frag_nd']} fragmented ND frame(s) - RFC 6980 says "
           "receivers MUST drop; presence = RA-Guard/frag confusion surface "
           "-> raguard")
    if seen["vtp_rev"] is not None:
        info(f"VTP config revision observed: {seen['vtp_rev']} - feed it "
             "to: vtp (safe rev+1 proof; --wipe needs --i-know)")
    if seen["vtp"]:
        info("next: vtp  (summary rev+1 takeover probe, answer never by "
             "default)")
    for c in seen["conflicts"]:
        any_find = True
        hi(f"ARP conflict {c[0]}: {c[1]} vs {c[2]} (active spoofing?)")
    info(f"ARP hosts observed: {len(seen['hosts'])}")
    for ip, mac in sorted(seen["hosts"]):
        print(f"         {ip:<16} {mac}")
    if not any_find:
        info("no control-plane frames seen; try arpsweep to enumerate hosts")
    print("\n[*] vlan: vlanenum | vlanhop | voicevlan | dtp | doubletag | "
          "mvrp\n"
          "[*] l2:   portsteal | ghost | stproot | camflood | gratarp\n"
          "[*] l3:   arpspoof | roguedhcp | dhcpstarve | hsrp | vrrp | "
          "icmpredirect\n"
          "[*] v6:   roguera | ndpspoof | roguedhcp6 | raguard | daddos\n"
          "[*] proto: vtp | llmnr | scan")
    return seen

