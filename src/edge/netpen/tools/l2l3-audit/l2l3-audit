def parse_vlan_list(spec):
    """'1,2,10-20,1000' -> sorted set of ints"""
    out = set()
    for part in spec.split(","):
        part = part.strip()
        if "-" in part:
            a, b = part.split("-", 1)
            out.update(range(int(a), int(b) + 1))
        elif part:
            out.add(int(part))
    bad = [v for v in out if not 1 <= v <= 4094]
    if bad:
        die(f"invalid VLAN ids: {bad}")
    return sorted(out)


def active_vlan_probe(pif, vids, window, probe_native=True):
    """Ask candidate VLANs by name from the PHYSICAL parent: per VID a
    tagged DHCP Discover (xid -> VID fingerprint) plus a tagged IPv6
    Router Solicitation, and one untagged Discover for the native VLAN.
    Works the same whether our vantage is untagged or already on a
    tagged subinterface: a correctly bounded switch port drops every
    one of these frames, so anything answering is a misconfiguration
    (open trunk, hybrid port, missing allowed-VLAN pruning) - exactly
    the case we must not take the port's word on.

    Returns (stats, native):
      stats[vid] = {"offer": dhcp server ip or None, "frames": n tagged
                    frames seen on this VID in the window, "ra": n,
                    "srcs": {macs}}
      native     = {"offer": dhcp server ip or None} or None.
    A DHCP OFFER matching our per-VID xid PROVES bidirectional
    reachability; tagged ambient frames / RAs are weaker leak evidence.
    """
    xids = {}
    ours = {my_mac(pif).lower()}
    stats = {v: {"offer": None, "frames": 0, "ra": 0, "srcs": set()}
             for v in vids}
    native = {"offer": None, "xid": None} if probe_native else None

    def msgtype(p):
        return next((o[1] for o in p[DHCP].options
                     if isinstance(o, tuple) and o[0] == DHCP_MT), None)

    def matcher(p):
        if not p.haslayer(Ether) or p[Ether].src.lower() in ours:
            return
        q = p.getlayer(Dot1Q)
        if p.haslayer(BOOTP) and p.haslayer(DHCP) and p[BOOTP].op == 2:
            vid = xids.get(p[BOOTP].xid)
            if p[BOOTP].xid in xids and msgtype(p) == 2:
                srv = p[IP].src if p.haslayer(IP) else "?"
                if vid is None and native is not None:
                    native["offer"] = srv
                elif vid in stats:
                    stats[vid]["offer"] = srv
        if q is None or q.vlan not in stats:
            return
        s = stats[q.vlan]
        s["srcs"].add(p[Ether].src.lower())
        if p.haslayer(ICMPv6ND_RA):
            s["ra"] += 1
        else:
            s["frames"] += 1

    sn = AsyncSniffer(iface=pif, prn=matcher)
    sn.start()
    for v in vids:
        mac = rand_mac()
        ours.add(mac.lower())
        xid = random.randint(0, 0xFFFFFFFF)
        xids[xid] = v
        chaddr = int(mac.replace(":", ""), 16).to_bytes(6, "big") + \
            b"\x00" * 10
        disc = (Ether(src=mac, dst="ff:ff:ff:ff:ff:ff") /
                Dot1Q(vlan=v) /
                IP(src="0.0.0.0", dst="255.255.255.255") /
                UDP(sport=68, dport=67) /
                BOOTP(chaddr=chaddr, xid=xid) /
                DHCP(options=[(DHCP_MT, "discover"), "end"]))
        rs = (Ether(src=mac, dst="33:33:00:00:00:02") /
              Dot1Q(vlan=v) /
              IPv6(src=ll6_from_mac(mac), dst="ff02::2", hlim=255) /
              ICMPv6ND_RS() /
              ICMPv6NDOptSrcLLAddr(lladdr=mac))
        sendp([disc, rs], iface=pif, verbose=0)
    if native is not None:
        mac = rand_mac()
        ours.add(mac.lower())
        native["xid"] = random.randint(0, 0xFFFFFFFF)
        xids[native["xid"]] = None
        chaddr = int(mac.replace(":", ""), 16).to_bytes(6, "big") + \
            b"\x00" * 10
        sendp(Ether(src=mac, dst="ff:ff:ff:ff:ff:ff") /
              IP(src="0.0.0.0", dst="255.255.255.255") /
              UDP(sport=68, dport=67) /
              BOOTP(chaddr=chaddr, xid=native["xid"]) /
              DHCP(options=[(DHCP_MT, "discover"), "end"]),
              iface=pif, verbose=0)
    time.sleep(window)
    sn.stop()
    return stats, native


def vlanenum_cmd(args):
    """Discover tagged VLANs reachable from this port: passive (leaks) +
    optional active tagged probes (gaps G1)."""
    need_root()
    pif = parent_of(args.iface)
    print(f"[*] VLAN enumeration on {pif} (port never assumed tagged)")

    found = {"tags": {}, "cdp_native": None, "cdp_voice": None,
             "lldp_pvid": None, "vtp": {}, "pvst": set(), "dtp": 0,
             "dhcp6": set()}

    def ctl_vtp(body):
        """VTP subset-adv parse: pull every VLAN id+name in the DB."""
        if len(body) < 42 or body[1] != 0x02:  # code 0x02 = subset adv
            return
        off = 40 + 4  # hdr(40: ver,code,seq,remlen+domain32) + rev(4)
        while off < len(body):
            if off + 4 > len(body):
                break
            vlen = body[off]
            if vlen < 12 or off + vlen > len(body):
                break
            vid = struct.unpack("!H", body[off + 4:off + 6])[0]
            nlen = body[off + 3]
            name = body[off + 12:off + 12 + min(nlen, vlen - 12)]
            found["vtp"][vid] = name.decode(errors="replace")
            off += (vlen + 3) & ~3

    def pkt(p):
        # stacked tag walk
        lay = p
        while lay is not None and lay.name != "NoPayload":
            if lay.name in ("Dot1Q", "Dot1AD") and hasattr(lay, "vlan"):
                found["tags"][lay.vlan] = \
                    found["tags"].get(lay.vlan, 0) + 1
            lay = lay.payload
        try:
            dp = Dot3(bytes(p))
        except Exception:
            dp = p
        if dp.haslayer(SNAP):
            sn = dp[SNAP]
            body = bytes(sn.payload)
            if getattr(sn, "OUI", 0) == 0x00000C:
                if sn.code == 0x2000:  # CDP
                    for t, v in parse_tlvs(body[4:]):
                        if t == 0x000A and len(v) >= 2:
                            found["cdp_native"] = struct.unpack("!H",
                                                                v[:2])[0]
                        elif t == 0x000E:      # Appliance VLAN (voice)
                            found["cdp_voice"] = v[-2:] and struct.unpack(
                                "!H", v[-2:])[0]
                        elif t == 0x0009:      # VTP domain (bleak intro)
                            found.setdefault("vtp_domain",
                                             v.decode(errors="replace"))
                elif sn.code == 0x2003:  # VTP
                    ctl_vtp(body)
                elif sn.code == 0x2004:  # DTP
                    found["dtp"] += 1
                elif sn.code == 0x010B:  # PVST+ BPDU (tagged per VLAN)
                    q = p.getlayer(Dot1Q)
                    if q:
                        found["pvst"].add(q.vlan)
        if p.haslayer(UDP) and (p[UDP].dport in (546, 547)
                                or p[UDP].sport in (546, 547)):
            q = p.getlayer(Dot1Q)
            if q:
                found["dhcp6"].add(q.vlan)

    print(f"[*] passive: {args.time}s leak collection (tags, CDP native/voice,"
          " VTP db, PVST+, DTP)")
    sniff(iface=pif, timeout=args.time, store=False, prn=pkt)

    if args.active is not None:
        if args.active:
            vids = parse_vlan_list(args.active)
        else:
            vids = sorted(set(found["tags"]) | found["pvst"]
                          | set(found["vtp"]))
        if not vids:
            print("[*] no candidate VLANs for active probing "
                  "(passive leaks empty); pass --active 1,10-30,... to force")
        else:
            print(f"[*] active: tagged DHCP+RS probes on {len(vids)} "
                  f"VLAN(s), {args.probe_window}s reply window")
            stats, _ = active_vlan_probe(pif, vids, args.probe_window)
            proven = [v for v, s in stats.items() if s["offer"]]
            weak = [v for v, s in stats.items()
                    if not s["offer"] and s["frames"]]
            for v in sorted(set(proven + weak) | set(found["tags"])):
                found["tags"].setdefault(v, 0)
            if proven:
                print(f"[!] DHCP PROOF: VLAN(s) "
                      f"{', '.join(map(str, proven))} answered a tagged "
                      "Discover - broadcast domains reachable from this "
                      "port (misconfig)")
            elif weak:
                print(f"[*] tagged frames from VLAN(s) "
                      f"{', '.join(map(str, weak))} in the window "
                      "(no DHCP proof)")

    print("\n================ VLAN ENUMERATION ================")
    print("[*] leak report:")
    if found["tags"]:
        print(f"  tagged frames observed: " + ", ".join(
            f"VLAN {v} ({c}x)" for v, c in sorted(found["tags"].items())))
    else:
        print("  no 802.1Q/QinQ tags seen (plain access port or stripped "
              "egress)")
    if found["cdp_native"] is not None:
        print(f"  CDP native VLAN: {found['cdp_native']} "
              "(outer tag for double-tagging)")
    if found["cdp_voice"] is not None:
        print(f"  CDP voice VLAN (VVID): {found['cdp_voice']} -> voicevlan")
    if found["vtp"]:
        n = ", ".join(f"VLAN {v} ({n_})" for v, n_ in
                      sorted(found["vtp"].items())[:12])
        print(f"  VTP subset-adv leaked {len(found['vtp'])} VLANs: {n}"
              + (" ..." if len(found["vtp"]) > 12 else ""))
    if found.get("vtp_domain"):
        print(f"  VTP/C mgmt domain: {found['vtp_domain']} -> vtp")
    if found["pvst"]:
        print(f"  PVST+ per-VLAN BPDUs: trunk carries "
              f"{', '.join(str(v) for v in sorted(found['pvst']))}")
    if found["dtp"]:
        print(f"  DTP frames: {found['dtp']} (negotiation ON -> dtp)")
    cand = sorted(set(found["tags"]) | found["pvst"] | set(found["vtp"]))
    if cand:
        print(f"\n[*] next: l2l3-audit vlanhop --vlan {cand[0]}  "
              f"(or each of {', '.join(map(str, cand))})")
    elif found["dtp"]:
        print("\n[*] next: l2l3-audit dtp (negotiate trunk), then vlanenum "
              "again to harvest the trunk's VLAN list")
    else:
        print("\n[*] no VLAN leak: port is plain access. Try vlanenum "
              "--active <range> if the port might forward tagged frames, or "
              "voicevlan if phones exist")
    return found


