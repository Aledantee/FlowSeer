{
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "compound-engineering@compound-engineering-plugin": false
  },
  "worktree": {
    "baseRef": "head"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/go-build",
        "~/Library/Caches/golangci-lint",
        "~/go/pkg/mod",
        "~/Library/pnpm/store",
        "~/Library/pnpm/package-manager-store",
        "~/Library/Caches/pnpm",
        "~/.cache/uv"
      ]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/hooks/worktree-guard.sh\""
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/hooks/create-worktree.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/hooks/worktree-guard.sh\""
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/tools/scripts/run.py", "hooks", "pre-tool-policy"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/hooks/worktree-guard.sh\""
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/tools/scripts/run.py", "hooks", "protect-generated-bash"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/tools/scripts/run.py", "hooks", "go-format"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/tools/scripts/run.py", "hooks", "proto-check"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/tools/scripts/run.py", "hooks", "suppression-warn"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/tools/scripts/run.py", "hooks", "mark-verification-dirty"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/tools/scripts/run.py", "hooks", "mark-verification-dirty"]
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/tools/scripts/run.py", "hooks", "commit-message-check"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/tools/scripts/run.py", "hooks", "stop-check"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
