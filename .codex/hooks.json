{
  "description": "FlowSeer repository policy and edit feedback.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/worktree-guard.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/worktree-guard.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/pre-tool-policy.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/worktree-guard.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/protect-generated-bash.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/go-format.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/proto-check.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/suppression-warn.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/mark-verification-dirty.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/mark-verification-dirty.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/hooks/stop-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
